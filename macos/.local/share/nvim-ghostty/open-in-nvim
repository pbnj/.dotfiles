#!/bin/sh
# Open the given files in Neovim, preferring the terminal that is already open.
#
# Strategies are tried in order until one succeeds:
#   herdr    a focused tab in the workspace labelled after the project
#   tmux     a new window in the attached (or most recent) session
#   ghostty  a fresh Ghostty instance, the original behaviour
#
# Override the order with NVIM_GHOSTTY_STRATEGY, which is how a single layer is
# exercised in isolation:  NVIM_GHOSTTY_STRATEGY=ghostty open-in-nvim file
#
# Invoked from the NvimGhostty.app AppleScript handler, which runs under
# `do shell script` with a minimal PATH (/usr/bin:/bin:/usr/sbin:/sbin) and no
# shell profile, so every non-system binary is resolved explicitly.

set -eu

STRATEGIES="${NVIM_GHOSTTY_STRATEGY:-herdr tmux ghostty}"
TERMINAL_APP="${NVIM_GHOSTTY_TERMINAL_APP:-Ghostty.app}"

find_bin() {
	for candidate in \
		"/opt/homebrew/bin/$1" \
		"/usr/local/bin/$1" \
		"/usr/bin/$1"; do
		[ -x "$candidate" ] && printf '%s\n' "$candidate" && return 0
	done
	command -v "$1" 2>/dev/null && return 0
	return 1
}

die() {
	/usr/bin/osascript -e "display alert \"NvimGhostty\" message \"$1\"" >/dev/null
	exit 1
}

nvim_bin=$(find_bin nvim) || die "Could not find the nvim binary."
herdr_bin=$(find_bin herdr) || herdr_bin=
tmux_bin=$(find_bin tmux) || tmux_bin=
jq_bin=$(find_bin jq) || jq_bin=

# Quoting matters twice over: Ghostty treats bare path arguments after `-e` as
# documents to open (spawning a second window that tries to execute the file),
# and both herdr and tmux take the command as a single string to hand a shell.
quote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

nvim_command=$(quote "$nvim_bin")
for f in "$@"; do
	nvim_command="$nvim_command $(quote "$f")"
done

# The project the first file belongs to: its git root when there is one, its
# own directory otherwise. This is what names the herdr workspace and the tmux
# window, and what both use as the working directory.
if [ $# -gt 0 ]; then
	file_dir=$(/usr/bin/dirname "$1")
else
	file_dir="${HOME:-/}"
fi
project_root=$(/usr/bin/git -C "$file_dir" rev-parse --show-toplevel 2>/dev/null) ||
	project_root="$file_dir"
[ -n "$project_root" ] || project_root="$file_dir"
project_label=$(/usr/bin/basename "$project_root")

ghostty_run() { # <command line> -- run it in a fresh Ghostty instance
	# On macOS, Ghostty cannot be launched from the CLI directly; `open -na` is
	# the supported path, and -n is required because arguments are only consumed
	# at launch. The trade-off is a separate Ghostty instance per invocation.
	/usr/bin/open -na "$TERMINAL_APP" --args -e /bin/sh -c "$1"
}

activate_terminal() {
	app=$(/usr/bin/basename "$TERMINAL_APP" .app)
	/usr/bin/osascript -e "tell application \"$app\" to activate" >/dev/null 2>&1 || true
}

# --- herdr -------------------------------------------------------------------

# The server keeps running with no UI attached, in which case a new tab would be
# created out of sight. Clients are `herdr` with no subcommand; the server is
# `herdr server`. A `for` loop, not a pipe, so the result survives the subshell.
herdr_client_attached() {
	for pid in $(/usr/bin/pgrep -x herdr 2>/dev/null); do
		case " $(/bin/ps -o command= -p "$pid" 2>/dev/null) " in
		*" server "*) ;;
		*) return 0 ;;
		esac
	done
	return 1
}

try_herdr() {
	[ -n "$herdr_bin" ] && [ -n "$jq_bin" ] || return 1
	"$herdr_bin" status 2>/dev/null | grep -q 'status: running' || return 1

	# Reuse the workspace named after the project rather than duplicating it,
	# the same convention fzf-herdr-project follows.
	# shellcheck disable=SC2016  # $label is a jq variable, not a shell one
	workspace=$("$herdr_bin" workspace list 2>/dev/null |
		"$jq_bin" -r --arg label "$project_label" \
			'.result.workspaces[]? | select(.label == $label) | .workspace_id' |
		head -1) || return 1

	if [ -n "$workspace" ]; then
		tab_label=$([ $# -gt 0 ] && /usr/bin/basename "$1" || printf 'nvim')
		response=$("$herdr_bin" tab create \
			--workspace "$workspace" \
			--cwd "$project_root" \
			--label "$tab_label" \
			--focus 2>/dev/null) || return 1
	else
		response=$("$herdr_bin" workspace create \
			--cwd "$project_root" \
			--label "$project_label" \
			--focus 2>/dev/null) || return 1
	fi

	pane=$(printf '%s' "$response" | "$jq_bin" -r '.result.root_pane.pane_id // empty')
	[ -n "$pane" ] || return 1

	# Not `exec nvim`: quitting Neovim should leave the tab at a shell prompt
	# rather than closing it.
	"$herdr_bin" pane run "$pane" "$nvim_command" >/dev/null 2>&1 || return 1

	if herdr_client_attached; then
		activate_terminal
	else
		ghostty_run "exec $(quote "$herdr_bin")"
	fi
	return 0
}

# --- tmux --------------------------------------------------------------------

try_tmux() {
	[ -n "$tmux_bin" ] || return 1

	# Prefer an attached session, then the most recently active one. Never start
	# a server: no session means this layer does not apply.
	session_row=$("$tmux_bin" list-sessions \
		-F '#{?session_attached,1,0} #{session_activity} #{session_name}' 2>/dev/null |
		sort -r | head -1) || return 1
	[ -n "$session_row" ] || return 1

	attached=${session_row%% *}
	session=${session_row#* }
	session=${session#* }
	[ -n "$session" ] || return 1

	"$tmux_bin" new-window -t "$session" -c "$project_root" -n "$project_label" \
		"$nvim_command" >/dev/null 2>&1 || return 1

	if [ "$attached" = 1 ]; then
		activate_terminal
	else
		ghostty_run "exec $(quote "$tmux_bin") attach -t $(quote "$session")"
	fi
	return 0
}

# --- ghostty -----------------------------------------------------------------

try_ghostty() {
	ghostty_run "exec $nvim_command"
}

# --- dispatch ----------------------------------------------------------------

for strategy in $STRATEGIES; do
	case "$strategy" in
	herdr) try_herdr "$@" && exit 0 ;;
	tmux) try_tmux "$@" && exit 0 ;;
	ghostty) try_ghostty "$@" && exit 0 ;;
	*) ;;
	esac
done

die "Could not open the file: every strategy ($STRATEGIES) failed."
