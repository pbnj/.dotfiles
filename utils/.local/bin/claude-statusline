#!/usr/bin/env bash
# Claude Code status line. Renders one line under the prompt:
#
#   opus-5.5 medium · dotfiles main · ctx 42% · 5h 8% 2h55m · 7d 17% 79h15m
#
# followed by one line per open pull request this session is working on --
# every PR a gh-pr-watch run in this session watches, plus any on the current
# branch -- most in need of attention first:
#
#   #249 Security-Automation · ci fail 2 · changes requested · 3 threads
#
# The PRs come from gh-pr-snapshots, which reads gh-pr-watch's snapshots and
# makes no GitHub calls. Five at most, then a count of the rest.
#
# The same facts used to go to the herdr sidebar instead, with this script
# printing nothing; they live here now so they sit in the session they describe.
# The sidebar carries the branch's pull request instead, published below.
# The labels and reset countdowns are dim, the model is bold, and each
# percentage turns orange past 75 and red past 90 -- the thresholds the sidebar
# used.
#
# Field docs: https://code.claude.com/docs/en/statusline
# Every field except the model is optional and is omitted when absent:
#   effort      - only for models supporting the reasoning effort parameter
#   rate_limits - only for Claude.ai Pro/Max, after the first API response
#   context_window.used_percentage - null early in a session and after /compact
#
# A watch updates its snapshot while the session sits idle, so
# statusLine.refreshInterval (30s, in ~/.claude/settings.json) re-runs this on
# a timer as well as on events; that keeps the reset countdowns current too.

input=$(cat)

j() { printf '%s' "$input" | jq -r "$1 // empty"; }

session=$(j '.session_id')
slug=$(j 'if .workspace.repo.owner and .workspace.repo.name then "\(.workspace.repo.owner)/\(.workspace.repo.name)" else empty end')
model=$(j '.model.display_name // .model.id')
effort=$(j '.effort.level')
cwd=$(j '.workspace.current_dir // .cwd')
ctx=$(j '.context_window.used_percentage')
five=$(j '.rate_limits.five_hour.used_percentage')
five_reset=$(j '.rate_limits.five_hour.resets_at')
week=$(j '.rate_limits.seven_day.used_percentage')
week_reset=$(j '.rate_limits.seven_day.resets_at')

# Publishes the branch's pull request to the herdr sidebar; agent-status does the
# lookup and is a no-op outside a herdr pane. Backgrounded and silenced: a slow
# `gh` or a missing transport must never delay or corrupt the status line itself.
# Like the countdowns, the PR only refreshes when the status line runs.
publish_status() {
    local writer=${HOME}/.local/bin/agent-status
    [ -n "${HERDR_PANE_ID:-}" ] && [ -x "$writer" ] || return 0
    jq -nc --arg session "$session" --arg cwd "$cwd" \
        '{agent: "claude", session: $session, cwd: $cwd}' 2>/dev/null \
        | "$writer" >/dev/null 2>&1 &
}

publish_status

# resets_at is documented as Unix epoch seconds; ISO 8601 is handled defensively
# so a future format change degrades to a missing reset time rather than garbage.
to_epoch() {
    local t=$1 epoch
    [ -n "$t" ] || return 1
    case $t in
        *[!0-9.]*)
            t=${t%%.*}
            t=${t%Z}
            epoch=$(date -j -u -f '%Y-%m-%dT%H:%M:%S' "$t" '+%s' 2>/dev/null) || return 1
            ;;
        *) epoch=${t%%.*} ;;
    esac
    printf '%s' "$epoch"
}

# Renders the time remaining until a reset epoch, e.g. "2h14m" or "38m".
fmt_remaining() {
    local epoch=$1 now diff h m
    [ -n "$epoch" ] || return 0
    now=$(date '+%s')
    diff=$(( epoch - now ))
    [ "$diff" -gt 0 ] || { printf 'now'; return 0; }
    h=$(( diff / 3600 ))
    m=$(( (diff % 3600) / 60 ))
    if [ "$h" -gt 0 ]; then
        printf '%dh%dm' "$h" "$m"
    else
        printf '%dm' "$m"
    fi
}

DIM=$'\033[2m'
BOLD=$'\033[1m'
ORANGE=$'\033[38;2;192;118;23m'
RED=$'\033[1;38;2;219;75;75m'
RESET=$'\033[0m'

# A percentage, rounded, colored by how close it is to the limit. Literal RGB
# rather than palette colors, as mid-tones that hold up on light and dark themes.
pct() {
    local p
    p=$(awk -v p="$1" 'BEGIN{printf "%.0f", p}')
    if [ "$p" -gt 90 ]; then
        printf '%s%s%%%s' "$RED" "$p" "$RESET"
    elif [ "$p" -gt 75 ]; then
        printf '%s%s%%%s' "$ORANGE" "$p" "$RESET"
    else
        printf '%s%%' "$p"
    fi
}

dim() { printf '%s%s%s' "$DIM" "$1" "$RESET"; }

# "Opus 5.5" -> "opus-5.5"
model=${model// /-}
model=$(printf '%s' "$model" | tr '[:upper:]' '[:lower:]')
effort=$(printf '%s' "$effort" | tr '[:upper:]' '[:lower:]')

# Repo root basename plus the branch, falling back to a short SHA on a detached
# HEAD.
repo=""
branch=""
if [ -n "$cwd" ] && [ -d "$cwd" ]; then
    root=$(git -C "$cwd" --no-optional-locks rev-parse --show-toplevel 2>/dev/null)
    if [ -n "$root" ]; then
        repo=$(basename "$root")
        branch=$(git -C "$cwd" --no-optional-locks branch --show-current 2>/dev/null)
        [ -n "$branch" ] || branch=$(git -C "$cwd" --no-optional-locks rev-parse --short HEAD 2>/dev/null)
    else
        repo=$(basename "$cwd")
    fi
fi

segments=()

seg="$BOLD$model$RESET"
[ -n "$effort" ] && seg="$seg $(dim "$effort")"
segments+=("$seg")

if [ -n "$repo" ]; then
    seg=$repo
    [ -n "$branch" ] && seg="$seg $(dim "$branch")"
    segments+=("$seg")
fi

[ -n "$ctx" ] && segments+=("$(dim ctx) $(pct "$ctx")")

for window in "5h|$five|$five_reset" "7d|$week|$week_reset"; do
    IFS='|' read -r label used reset <<<"$window"
    [ -n "$used" ] || continue
    seg="$(dim "$label") $(pct "$used")"
    remaining=$(fmt_remaining "$(to_epoch "$reset")")
    [ -n "$remaining" ] && seg="$seg $(dim "$remaining")"
    segments+=("$seg")
done

sep=" $(dim '·') "
out=${segments[0]}
for seg in "${segments[@]:1}"; do
    out="$out$sep$seg"
done

printf '%s' "$out"

# One line per open PR. The number links to the PR (OSC 8).
GREEN=$'\033[38;2;65;163;91m'
pr_lines() {
    local prs=$1
    jq -r --arg dim "$DIM" --arg reset "$RESET" --arg red "$RED" \
        --arg orange "$ORANGE" --arg green "$GREEN" --arg bold "$BOLD" '
        def color($c; $s): "\($c)\($s)\($reset)";
        def link($url; $s): "\u001b]8;;\($url)\u001b\\\($s)\u001b]8;;\u001b\\";
        (.[:5][] | [
            (link(.url; color($bold; "#\(.number)")) + " " + (.repo | split("/")[1])
             + (if .state == "draft" then " " + color($dim; "draft") else "" end)),
            (if .ci == "fail" then color($red; "ci fail \(.ci_counts.fail)")
             elif .ci == "pending" then color($orange; "ci pending \(.ci_counts.pending)")
             elif .ci == "pass" then color($green; "ci pass")
             else empty end),
            (if .review == "changes" then color($red; "changes requested")
             elif .review == "review" then color($orange; "review required")
             elif .review == "approved" then color($green; "approved")
             else empty end),
            ((.threads // []) | length | select(. > 0)
             | color(if . > 4 then $red else $orange end; "\(.) thread\(if . > 1 then "s" else "" end)")),
            (if (now - (.fetched_at // 0)) > ([3 * (.interval // 60), 60] | max) then color($dim; "stale") else empty end)
          ] | join(" \($dim)·\($reset) ")),
        (length - 5 | select(. > 0) | color($dim; "+\(.) more"))
        ' <<<"$prs" 2>/dev/null
}

prs=$("${HOME}/.local/bin/gh-pr-snapshots" --agent claude --session "$session" \
    --repo "$slug" --branch "$branch" 2>/dev/null) || prs='[]'
while IFS= read -r line; do
    [ -n "$line" ] && printf '\n%s' "$line"
done < <(pr_lines "${prs:-[]}")
