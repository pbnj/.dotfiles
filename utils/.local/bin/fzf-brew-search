#!/usr/bin/env bash

set -eou pipefail
[[ "${DEBUG:-}" == "true" ]] && set -x

# Search Homebrew formulae and casks by name and description (brew desc
# --search) as you type, with `brew info` as the preview, then install or
# uninstall the picks (TAB for several). The query is brew's, not a fuzzy
# filter: it's searched once it has two or more characters. An empty query
# lists what's installed. An optional argument is the first query.
#
#   ENTER   brew install (casks with --cask)
#   ALT-D   brew uninstall, then brew autoremove
#
# brew runs in the foreground and waits for a key once it's done, then the
# picker comes back with the same query, its results reloaded. Esc quits.
#
# The binds call this script back with an internal subcommand:
#   --list QUERY        print name<TAB>type<TAB>description lines
#   --run ACTION FILE   brew ACTION the picks in FILE (fzf's {+f})

SELF="${BASH_SOURCE[0]}"

# name<TAB>type<TAB>description, from brew desc --search's "==> Formulae" and
# "==> Casks" sections, or from brew list for an empty query. brew's
# untrusted-tap warnings go to stderr and are dropped.
list() {
  local q="$1"
  if [[ -z "${q}" ]]; then
    brew list --formula 2>/dev/null | sed 's/$/\tformula\tinstalled/'
    brew list --cask 2>/dev/null | sed 's/$/\tcask\tinstalled/'
    return 0
  fi
  [[ ${#q} -ge 2 ]] || return 0
  brew desc --search "${q}" 2>/dev/null | awk '
    /^==> Formulae/ { type = "formula"; next }
    /^==> Casks/    { type = "cask"; next }
    type && /: / {
      i = index($0, ": ")
      printf "%s\t%s\t%s\n", substr($0, 1, i - 1), type, substr($0, i + 2)
    }'
}

# brew $1 the picks in the file $2: formulae and casks in separate calls,
# casks with --cask, so a cask sharing a formula's name is still the one acted
# on. After an uninstall, brew autoremove drops orphaned dependencies.
run() {
  local action="$1" picks="$2" status=0
  local name type
  local -a formulae=() casks=()
  while IFS=$'\t' read -r name type _; do
    case "${type}" in
    formula) formulae+=("${name}") ;;
    cask) casks+=("${name}") ;;
    esac
  done <"${picks}"
  if ((${#formulae[@]})); then
    brew "${action}" "${formulae[@]}" || status=$?
  fi
  if ((${#casks[@]})); then
    brew "${action}" --cask "${casks[@]}" || status=$?
  fi
  if [[ "${action}" == uninstall ]] && ((status == 0)); then
    brew autoremove || status=$?
  fi
  echo
  # Drop keys pressed while brew ran, so only a key pressed now returns.
  # (A fractional -t needs bash 4+, hence env bash above.)
  while read -rsn1 -t 0.01 _ </dev/tty; do :; done
  read -rsn1 -p 'Press any key to return to the search' </dev/tty || true
  return "${status}"
}

case "${1:-}" in
--list)
  list "${2:-}"
  exit 0
  ;;
--run)
  run "$2" "$3"
  exit
  ;;
esac

INPUT="${1:-}"
LIST="'${SELF}' --list {q}"

fzf \
  --tmux 'center,80%' \
  --reverse \
  --multi \
  --disabled \
  --query "${INPUT}" \
  --delimiter '\t' \
  --with-nth '1,3' \
  --header 'TAB: select / ENTER: install / ALT-D: uninstall / ESC: quit' \
  --prompt 'brew search> ' \
  --bind "start:reload:${LIST}" \
  --bind "change:reload:sleep 0.3; ${LIST}" \
  --bind "enter:execute('${SELF}' --run install {+f})+clear-selection+reload:${LIST}" \
  --bind "alt-d:execute('${SELF}' --run uninstall {+f})+clear-selection+reload:${LIST}" \
  --preview 'if [[ {2} == cask ]]; then brew info --cask {1}; else brew info --formula {1}; fi' \
  --preview-window 'right,60%'
