#!/usr/bin/env bash
# linear-cycle -- pick Linear issues assigned to you in your teams' active
# cycles, each team's own cycle, with fzf and send each to fai, which picks a
# directory and starts an agent there with the issue's URL typed into its
# prompt.
#
# Usage: linear-cycle
#
# The list is grouped by status (in progress first, then to do, backlog, done
# and canceled), then by priority, as ID, team, status, priority and title. The
# footer names each cycle and when it ends, and the status filter in use. A
# preview shows the issue.
#
# ALT-S filters the list by status: it opens a picker of the statuses (with
# how many issues each has), TAB marks several, and "any" clears the filter.
# Typing still fuzzy-matches all of each line.
#
# TAB marks several issues. ENTER runs fai once per issue, in turn, so each can
# go to its own directory and agent; ESC in fai skips that issue. CTRL-V views
# an issue in full, paged; CTRL-O opens it in the browser; CTRL-Y copies its
# URL; CTRL-R refreshes the list. ESC quits.
#
# Dependencies: the linear CLI, logged in; fzf; jq; bat (for the preview); fai

set -euo pipefail
[[ "${DEBUG:-}" == "true" ]] && set -x

self="$(realpath "${BASH_SOURCE[0]}")"
# The picker's state: the fetched issues (issues.tsv), the cycles (cycles),
# the statuses to show (status, one per line) and the last error (error). Set
# by the picker's own run of this script, and inherited by fzf's bindings.
state="${LINEAR_CYCLE_STATE:-}"

# refresh: fetch the issues into the state, tab-separated: URL, ID, team,
# status, priority, title. On failure the old list is kept, and the error
# saved for the footer.
refresh() {
  local json
  if json="$(linear api '
    {
      viewer {
        assignedIssues(
          first: 250
          filter: { cycle: { isActive: { eq: true } } }
        ) {
          nodes {
            url identifier title priority priorityLabel
            team { key }
            state { name type }
            cycle { number name endsAt }
          }
        }
      }
    }' 2>"${state}/error" | jq -e '.data.viewer.assignedIssues.nodes')"; then
    jq -r '
      def rank: {started: 0, unstarted: 1, triage: 2, backlog: 3,
                 completed: 4, canceled: 5}[.state.type] // 6;
      # priority 0 is none, so it sorts after 4 (low)
      def prio: if .priority == 0 then 5 else .priority end;
      sort_by(rank, prio, .identifier) | .[]
      | [.url, .identifier, .team.key, .state.name, .priorityLabel,
         (.title | gsub("[\t\n\r]"; " "))]
      | @tsv' <<<"${json}" >"${state}/issues.tsv"
    jq -r '
      [.[] | .cycle + {team: .team.key}] | unique_by(.team, .number)
      | map("\(.team) \(.name // "Cycle \(.number)") (ends \(.endsAt[:10]))")
      | if length == 0 then "No issues in an active cycle"
        else join(" · ") end' <<<"${json}" >"${state}/cycles"
    : >"${state}/error"
  else
    [[ -s "${state}/error" ]] || echo "fetching issues failed" >"${state}/error"
  fi
}

# filter: print the fetched issues the status filter leaves
filter() {
  [[ -f "${state}/issues.tsv" ]] || return 0
  if [[ -s "${state}/status" ]]; then
    awk -F'\t' 'NR == FNR { want[$0] = 1; next } $4 in want' \
      "${state}/status" "${state}/issues.tsv"
  else
    cat "${state}/issues.tsv"
  fi
}

# list: print the issues for fzf: URL, ID, then the line shown
list() {
  filter | awk -F'\t' -v OFS='\t' '{
    print $1, $2, sprintf("%-10s %-5s %-14.14s %-11.11s %s", $2, $3, $4, $5, $6)
  }'
}

# footer: print the cycles, the status filter in use, and any error from the
# last refresh
footer() {
  local status="any"
  if [[ -s "${state}/status" ]]; then
    status="$(paste -sd, "${state}/status")"
    status="${status//,/, }"
  fi
  printf '%s · Status: %s' "$(cat "${state}/cycles" 2>/dev/null)" "${status}"
  if [[ -s "${state}/error" ]]; then
    printf '\nError: %s' "$(head -n1 "${state}/error")"
  fi
}

# pick: choose the statuses to show, with fzf, in the list's order
pick() {
  local picked
  picked="$(
    {
      printf '%5s\t%s\n' "" any
      cut -f4 "${state}/issues.tsv" 2>/dev/null |
        awk '!($0 in n) { order[++k] = $0 } { n[$0]++ }
          END { for (i = 1; i <= k; i++) printf "%5d\t%s\n", n[order[i]], order[i] }'
    } | fzf \
      --multi \
      --delimiter='\t' \
      --prompt='Status> ' \
      --header='ENTER: filter / TAB: mark / ESC: keep' \
      --reverse
  )" || return 0
  picked="$(cut -f2 <<<"${picked}")"
  if grep -qx any <<<"${picked}"; then
    : >"${state}/status"
  else
    printf '%s\n' "${picked}" >"${state}/status"
  fi
}

# open_url <url>: open a URL in the browser
open_url() {
  if command -v open >/dev/null; then open "${1}"; else xdg-open "${1}"; fi
}

# copy_url <url>: copy a URL to the clipboard
copy_url() {
  if command -v pbcopy >/dev/null; then
    printf '%s' "${1}" | pbcopy
  else
    printf '%s' "${1}" | wl-copy
  fi
}

main() {
  local q urls url
  state="$(mktemp -d)"
  export LINEAR_CYCLE_STATE="${state}"
  trap 'rm -rf "${state}"' EXIT
  q="$(printf '%q' "${self}")"
  refresh

  urls="$(list | fzf \
    --multi \
    --delimiter='\t' \
    --with-nth=3 \
    --prompt='My cycle> ' \
    --header='ENTER: send to fai / TAB: mark / ALT-S: status / CTRL-V: view / CTRL-O: browser / CTRL-Y: copy URL / CTRL-R: refresh' \
    --footer="$(footer)" \
    --reverse \
    --preview='linear issue view --no-pager --no-comments {2} | bat -pl md --color=always' \
    --preview-window='right,50%,wrap,<120(down,50%,wrap)' \
    --bind="alt-s:execute(${q} --pick)+reload-sync(${q} --list)+transform-footer(${q} --footer)" \
    --bind="ctrl-v:execute(linear issue view {2} | bat -l md --paging=always --style=plain --color=always)" \
    --bind="ctrl-o:execute-silent(${q} --open {1})" \
    --bind="ctrl-y:execute-silent(${q} --copy {1})" \
    --bind="ctrl-r:reload-sync(${q} --refresh; ${q} --list)+transform-footer(${q} --footer)" |
    cut -f1)" || exit 0

  while read -r url; do
    [[ -n "${url}" ]] || continue
    # fai reads the terminal, not the list
    fai "${url}" </dev/tty || true
  done <<<"${urls}"
}

case "${1:-}" in
--refresh) refresh ;;
--list) list ;;
--footer) footer ;;
--pick) pick ;;
--open) open_url "${2:?url}" ;;
--copy) copy_url "${2:?url}" ;;
"") main ;;
*)
  echo "Usage: linear-cycle" >&2
  exit 2
  ;;
esac

# vim:sts=2:ts=2:sw=2:et:
