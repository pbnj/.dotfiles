#!/usr/bin/env bash

# Author: Peter Benjamin
# Description: Fuzzy-find git projects and open each selection in a new Herdr workspace.
#              A project that is not cloned yet can be cloned from GitHub into
#              ~/Projects/github.com/<org>/<repo> with <CTRL-Y>.
#              <ALT-ENTER> opens the workspace and starts a coding agent in it,
#              picked from the AGENT_KINDS below that are actually installed.
# Dependencies: brew install fd fzf gh herdr jq
# Usage: fzf-herdr-project [initial query]
#        Bind to prefix+ctrl+f via [[keys.command]] type = "popup" in herdr config.toml

set -euo pipefail
[[ "${DEBUG:-}" == "true" ]] && set -x

QUERY="${1:-}"
SEARCH_ROOTS=(
  "${HOME}/Projects"
  "${HOME}/.dotfiles"
)
# Offered by <ALT-ENTER>, in this order. Each entry is run as a command in the
# new pane, so it must be the executable's own name.
AGENT_KINDS=(claude pi copilot)
CLONE_ROOT="${HOME}/Projects/github.com"
MAX_DEPTH="${HERDR_PROJECT_DEPTH:-5}"

project_list() {
  fd --hidden --no-ignore --type d --max-depth "${MAX_DEPTH}" '^\.git$' "${SEARCH_ROOTS[@]}" \
    -x dirname {} | sort -u
}

project_preview() {
  local dir="${1:-}"
  echo "${dir}"
  echo
  git -C "${dir}" log --oneline --decorate --color=always -10 2>/dev/null || true
  echo
  git -C "${dir}" status --short --branch 2>/dev/null || true
}

project_pull() {
  local dir
  for dir in "$@"; do
    git -C "${dir}" pull --rebase --autostash --prune --quiet 2>/dev/null || true
  done
}

# Reduce anything that names a GitHub repo -- org/repo, a clone URL, an https
# URL -- to the bare "org/repo" the clone path is built from. Prints nothing when
# the input is not a fully qualified repo, which is the signal to fall back to a
# GitHub search.
normalize_spec() {
  local spec="${1:-}"
  spec="${spec#git@github.com:}"
  spec="${spec#https://github.com/}"
  spec="${spec#github.com/}"
  spec="${spec%.git}"
  spec="${spec%/}"
  [[ "${spec}" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]] || return 0
  printf '%s\n' "${spec}"
}

# Literal first: an exact org/repo clones without a network round-trip. Anything
# else goes through `gh search repos` so the repo is confirmed to exist before
# git touches the disk.
resolve_spec() {
  local query="${1:-}" spec
  if [[ -z "${query}" ]]; then
    echo "Nothing to clone: type an org/repo (or a repo name to search) first." >&2
    return 1
  fi

  spec="$(normalize_spec "${query}")"
  if [[ -n "${spec}" ]]; then
    printf '%s\n' "${spec}"
    return 0
  fi

  spec="$(gh search repos --limit 30 --json fullName --jq '.[].fullName' "${query}" 2>/dev/null |
    fzf --reverse \
      --prompt="GitHub repo> " \
      --header='<ENTER>: clone into '"${CLONE_ROOT}"'/<org>/<repo>' \
      --preview='gh repo view {}' \
      --preview-window='bottom,60%' || true)"

  if [[ -z "${spec}" ]]; then
    echo "No GitHub repo matched '${query}'." >&2
    return 1
  fi
  printf '%s\n' "${spec}"
}

# Prints the project directory on success so the caller can hand it to
# open_workspaces. Already-cloned repos short-circuit instead of erroring.
clone_repo() {
  local spec="${1:-}" dir="${CLONE_ROOT}/${1:-}"

  if [[ -d "${dir}/.git" ]]; then
    echo "Already cloned: ${dir}" >&2
    printf '%s\n' "${dir}"
    return 0
  fi

  mkdir -p "$(dirname "${dir}")"
  if ! gh repo clone "${spec}" "${dir}"; then
    echo "Failed to clone ${spec} into ${dir}." >&2
    return 1
  fi
  printf '%s\n' "${dir}"
}

installed_agent_kinds() {
  local kind
  for kind in "${AGENT_KINDS[@]}"; do
    command -v "${kind}" >/dev/null 2>&1 && printf '%s\n' "${kind}"
  done
}

# Prints the chosen `--kind`, or nothing when the user escapes out -- which the
# callers read as "just open the shell", not as an error.
pick_agent_kind() {
  local kinds=()
  while IFS= read -r kind; do
    kinds+=("${kind}")
  done < <(installed_agent_kinds)

  case "${#kinds[@]}" in
  0)
    echo "No agent from '${AGENT_KINDS[*]}' is installed; opening a shell." >&2
    return 0
    ;;
  1)
    printf '%s\n' "${kinds[0]}"
    return 0
    ;;
  esac

  printf '%s\n' "${kinds[@]}" |
    fzf --reverse \
      --prompt="Agent> " \
      --header='<ENTER>: start this agent in the workspace / <ESC>: shell only' ||
    true
}

# `pane run`, not `agent start`, because this runs inside a herdr popup and the
# popup lives exactly as long as this script. `agent start` blocks until herdr
# has detected the agent and calls it interactive-ready -- measured at 3s for pi
# and longer for claude, with a floor of 3s since it rejects any --timeout below
# 3000ms -- so the picker sat on screen for the whole startup.
#
# Its return value is the only thing that wait buys: a validated agent identity
# and a CLI-targetable name. Neither survives the trade. Detaching the call into
# its own session does close the popup at once (verified), but then nothing is
# left to read the result it waited for. So send the command the way it would be
# typed by hand and let herdr's ordinary detection pick the agent up -- verified
# to work with no sleep between `workspace create` and this call.
#
# This makes installed_agent_kinds' `command -v` gate load-bearing: a missing
# binary now surfaces as `command not found` in the pane rather than an error
# here.
launch_agent_in_pane() {
  local kind="${1}" pane="${2}" dir="${3}"
  if ! herdr pane run "${pane}" "${kind}" >/dev/null 2>&1; then
    echo "Could not run ${kind} in ${pane} for ${dir}." >&2
    return 1
  fi
}

# The first pane of the active tab that has no agent in it, so an already-busy
# workspace is never typed over. Prints nothing when every pane is taken.
free_pane_in_workspace() {
  local workspace="${1}"
  herdr pane list --workspace "${workspace}" 2>/dev/null |
    jq -r '[.result.panes[]? | select(has("agent") | not)] | .[0].pane_id // empty'
}

workspace_has_agent() {
  herdr pane list --workspace "${1}" 2>/dev/null |
    jq -e 'any(.result.panes[]?; has("agent"))' >/dev/null
}

# open_workspaces <agent-kind> <dir>... -- an empty kind opens a bare shell.
open_workspaces() {
  local kind="${1}"
  shift
  local dirs=("$@")
  local last_index=$((${#dirs[@]} - 1))
  local i dir label existing focus created pane

  for i in "${!dirs[@]}"; do
    dir="${dirs[$i]}"
    [[ -d "${dir}" ]] || continue
    label="$(basename "${dir}")"
    if [[ "${i}" -eq "${last_index}" ]]; then focus="--focus"; else focus="--no-focus"; fi

    # Reuse an existing workspace with the same label instead of duplicating it.
    existing="$(herdr workspace list 2>/dev/null |
      jq -r --arg label "${label}" '.result.workspaces[]? | select(.label == $label) | .workspace_id' |
      head -1)"

    if [[ -n "${existing}" ]]; then
      [[ "${focus}" == "--focus" ]] && herdr workspace focus "${existing}" >/dev/null

      # An agent is already at work here -- focusing it is the whole job.
      if [[ -n "${kind}" ]] && ! workspace_has_agent "${existing}"; then
        pane="$(free_pane_in_workspace "${existing}")"
        if [[ -n "${pane}" ]]; then
          launch_agent_in_pane "${kind}" "${pane}" "${dir}" || true
        else
          echo "No free pane in ${label}; skipping ${kind}." >&2
        fi
      fi
      continue
    fi

    created="$(herdr workspace create --cwd "${dir}" --label "${label}" "${focus}")" || continue
    [[ -n "${kind}" ]] || continue

    pane="$(printf '%s' "${created}" | jq -r '.result.root_pane.pane_id // empty')"
    if [[ -n "${pane}" ]]; then
      launch_agent_in_pane "${kind}" "${pane}" "${dir}" || true
    else
      echo "Could not read the new pane id for ${label}; skipping ${kind}." >&2
    fi
  done
}

export -f project_preview project_pull

# --print-query and --expect make the first two output lines the typed query and
# the key that closed fzf; the selections follow.
OUTPUT=()
while IFS= read -r line; do
  OUTPUT+=("${line}")
done < <(
  project_list | fzf \
    --multi \
    --reverse \
    --prompt="Project> " \
    --query="${QUERY}" \
    --header='<TAB>: multi-select / <CTRL-G>: git pull --rebase --autostash / <CTRL-Y>: clone from GitHub / <ENTER>: open in new Herdr workspace / <ALT-ENTER>: open and start an agent' \
    --preview='project_preview {}' \
    --preview-window='right,50%' \
    --bind='ctrl-g:execute-silent(project_pull {+})+refresh-preview' \
    --with-nth=-2.. \
    --delimiter=/ \
    --print-query \
    --expect=ctrl-y,alt-enter || true
)

[[ ${#OUTPUT[@]} -eq 0 ]] && exit 0

TYPED_QUERY="${OUTPUT[0]}"
KEY="${OUTPUT[1]:-}"
SELECTED=("${OUTPUT[@]:2}")

if [[ "${KEY}" == "ctrl-y" ]]; then
  SPEC="$(resolve_spec "${TYPED_QUERY}")" || exit 1
  DIR="$(clone_repo "${SPEC}")" || exit 1
  open_workspaces "" "${DIR}"
  exit 0
fi

[[ ${#SELECTED[@]} -eq 0 ]] && exit 0

KIND=""
[[ "${KEY}" == "alt-enter" ]] && KIND="$(pick_agent_kind)"

open_workspaces "${KIND}" "${SELECTED[@]}"
