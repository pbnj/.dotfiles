#!/usr/bin/env bash

# Author: Peter Benjamin
# Description: Run an AI agent in a repo picked with fzf, without leaving
#              the current directory. Words up to the first -flag (or
#              --) seed the picker, and a unique match launches straight away;
#              the rest go to the agent. ALT-C picks claude (again: the
#              cloud agent), ALT-G copilot and ALT-P pi; the prompt shows the
#              agent's icon. TAB / SHIFT-TAB mark several directories, and
#              each gets its own agent. The agent opens in a new tmux or Rex
#              window named after the repo (or here, outside both, for one
#              directory only), or in a split of the repo's window when one
#              is already open; CTRL-O runs it here instead (the first
#              directory here, any others in windows). A link or text below
#              goes to every agent. CTRL-T toggles a ripgrep search through
#              every local clone; picking a hit opens its repo with its
#              path:line typed into the agent's prompt. ESC or CTRL-C
#              cancels, opening nothing. ~/Projects/github.com and its owner
#              directories are in the list too, to run an agent across many
#              repos.
#              The cloud agent is Claude Code on claude.ai/code, attached with
#              `claude --cloud`; it needs a task up front, so fai asks for one
#              (seeded with any link below) unless args already give it.
#              Once the session's claude.ai/code URL shows up, fai opens it
#              in the browser too (not outside tmux and Rex, where it can't
#              read the screen).
#              A URL is a link to work on. A GitHub URL picks its repo; any
#              other URL (a Linear issue, a blog post) is shown under the
#              picker while you pick the repo. A pull request, issue or file
#              link, or any other URL, is typed into the agent's prompt once it
#              starts, ready to be added to and sent. In tmux, the new window's
#              @url is the repo and its pane's is that link, for prefix C-u.
#              FAI_TEXT is text to work on (right-click → Send to fai… on a
#              selection, see macos/.local/share/fai-send): its first line is
#              shown under the picker, and it is pasted into the agent's
#              prompt once it starts, unsent, after any link. The cloud
#              agent's task gets it below what you type.
#              The picker lists ~/Projects/github.com/<owner>/<repo>, shown
#              from github.com/ on. When the query matches no local repo, the
#              list switches to a GitHub repo search that re-runs as you
#              type, and switches back once a local repo matches again; a
#              GitHub pick is cloned into ~/Projects/github.com first. CTRL-X
#              deletes the highlighted local clone, after showing what would
#              be lost and asking. In grep mode (CTRL-T) each hit is shown as
#              owner/repo/path:line:text and previewed around its line. A
#              one-cell Nerd Font icon before the prompt's ">" shows the list:
#              a folder for local clones, the GitHub logo for a GitHub
#              search, a magnifier for grep. A pasted URL is taken out of the
#              query and shown in the footer.
# Dependencies: bat, fd, fzf, gh, jq, ripgrep; tmux or rex for windows
# Usage: fai [query...] [-- | -flag...] [args...]
#          fai dotfiles --model opus
#          fai dotfiles -- "fix the failing test"
#          fai https://github.com/owner/repo/pull/123
#          fai https://linear.app/team/issue/ENG-123
#        FAI_PICK=1 always stops at the picker, even on a unique match.
#        FAI_AGENTS="claude pi" sets the agents offered; the first
#        installed one is the default.
#        FAI_TEXT='...' fai pastes the text into the agent's prompt.

set -uo pipefail
[[ "${DEBUG:-}" == "true" ]] && set -x

self="$(realpath "${BASH_SOURCE[0]}")"

# The list's marker in the prompt, "<base> <marker>> " (see the header)
PICK_REPO_LOCAL=$'\uf07b'  # nf-fa-folder
PICK_REPO_GITHUB=$'\uf09b' # nf-fa-github
PICK_REPO_GREP=$'\uf002'   # nf-fa-search

# __pick_repo_in <marker>: whether FZF_PROMPT shows the list <marker> marks
__pick_repo_in() {
  [[ "${FZF_PROMPT:-}" == *" ${1}> " ]]
}

# __pick_repo_prompt <marker>: print the fzf action that swaps FZF_PROMPT's
# marker for <marker>
__pick_repo_prompt() {
  local base="${FZF_PROMPT%> }" m
  for m in "${PICK_REPO_LOCAL}" "${PICK_REPO_GITHUB}" "${PICK_REPO_GREP}"; do
    base="${base% "${m}"}"
  done
  printf 'change-prompt:%s %s> ' "${base}" "${1}"
}

# __pick_repo_spec <text>: print the owner/repo named by a GitHub URL (the
# repo, or a pull request, issue or file in it), a clone URL or a bare
# owner/repo; print nothing for anything else, including any other URL
__pick_repo_spec() {
  local spec="${1:-}" url=""
  spec="${spec#"${spec%%[![:space:]]*}"}"
  spec="${spec%"${spec##*[![:space:]]}"}"
  spec="${spec#git@github.com:}"
  [[ "${spec}" == http://* || "${spec}" == https://* ]] && url=1
  spec="${spec#http://}"
  spec="${spec#https://}"
  spec="${spec#www.}"
  if [[ "${spec}" == github.com/* ]]; then
    url=1
    spec="${spec#github.com/}"
  elif [[ -n "${url}" ]]; then
    return 0
  fi
  spec="${spec%%[?#]*}"
  # Only a URL may carry a path past the repo: /pull/123, /issues/4, /blob/...
  if [[ -n "${url}" && "${spec}" =~ ^([^/]+/[^/]+)/ ]]; then
    spec="${BASH_REMATCH[1]}"
  fi
  spec="${spec%/}"
  spec="${spec%.git}"
  if [[ "${spec}" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]]; then
    printf '%s\n' "${spec}"
  fi
}

# __pick_repo_unurl <query>: print the query with a URL in it rewritten: a
# GitHub URL to the owner/repo it names, any other URL to nothing, leaving the
# rest of the query. The URL is saved to $PICK_REPO_LINK first, since the
# rewrite loses it: any URL but a GitHub one, and a GitHub one only if it goes
# deeper than the repo (a pull request, issue or file).
__pick_repo_unurl() {
  local query="${1:-}" spec
  if [[ "${query}" == *github.com[/:]* ]]; then
    spec="$(__pick_repo_spec "${query}")"
    if [[ -n "${spec}" ]]; then
      if [[ "${query}" =~ (https?://)?(www\.)?github\.com/[^/[:space:]]+/[^/[:space:]]+/[^/?#[:space:]]+[^[:space:]]* ]]; then
        printf '%s\n' "${BASH_REMATCH[0]}" >"${PICK_REPO_LINK}"
      fi
      printf '%s\n' "${spec}"
      return 0
    fi
  fi
  if [[ "${query}" =~ https?://[^[:space:]]+ ]]; then
    printf '%s\n' "${BASH_REMATCH[0]}" >"${PICK_REPO_LINK}"
    query="${query/"${BASH_REMATCH[0]}"/}"
    query="${query#"${query%%[![:space:]]*}"}"
    query="${query%"${query##*[![:space:]]}"}"
  fi
  printf '%s\n' "${query}"
}

# __pick_repo_search <query>: owner/repo lines from GitHub for the query. The
# sleep is a debounce: fzf kills a running reload when the next keystroke
# starts another, so only a pause in typing hits the API. An exact owner/repo
# is looked up directly, since search ranks by text and may bury it.
__pick_repo_search() {
  local query="${1:-}" spec
  [[ -n "${query//[[:space:]]/}" ]] || return 0
  sleep 0.3
  spec="$(__pick_repo_spec "${query}")"
  if [[ -n "${spec}" ]] &&
    gh repo view "${spec}" --json nameWithOwner --jq .nameWithOwner 2>/dev/null; then
    return 0
  fi
  gh search repos --limit 50 --json fullName --jq '.[].fullName' -- "${query}" 2>/dev/null || true
}

# __pick_repo_grep <query>: ripgrep the query through every local clone, as
# owner/repo/path:line:text. Like __pick_repo_search, the sleep debounces;
# a one-character query would match nearly every line, so it waits for two.
__pick_repo_grep() {
  local query="${1:-}" root="${HOME}/Projects/github.com" dirs=()
  ((${#query} >= 2)) || return 0
  sleep 0.2
  cd "${root}" || return 0
  # Clones only: the parent directories (ending in /) would search them twice.
  mapfile -t dirs < <(grep -v '/$' "${PICK_REPO_LIST}" | sed "s|^${root}/||")
  rg --line-number --no-heading --color=always --smart-case \
    --max-columns=300 --max-columns-preview -- "${query}" "${dirs[@]}" 2>/dev/null || true
}

# __pick_repo_preview <line>: the preview for a list line: a local clone's
# recent commits (a parent directory's contents), a grep hit's file around its
# line, or a GitHub repo.
__pick_repo_preview() {
  local line="${1:-}" root="${HOME}/Projects/github.com" n
  if [[ "${line}" == */ ]]; then
    ls -1 "${line}"
  elif [[ "${line}" == /* ]]; then
    git -C "${line}" log --oneline --color -15
  elif [[ "${line}" =~ ^([^/]+/[^/]+/[^:]+):([0-9]+): ]]; then
    n="${BASH_REMATCH[2]}"
    bat --color=always --style=numbers,header --highlight-line "${n}" \
      --line-range "$((n > 10 ? n - 10 : 1)):" "${root}/${BASH_REMATCH[1]}"
  else
    gh repo view "${line}"
  fi
}

# __pick_repo_on_toggle: run by fzf on CTRL-T; prints the actions that switch
# between grep mode and repo names. Back
# from grep, the list is local or GitHub depending on the query, as in
# __pick_repo_on_query.
__pick_repo_on_toggle() {
  local query="${FZF_QUERY}"
  # shellcheck disable=SC2016 # expanded by the shell fzf runs reload in
  if __pick_repo_in "${PICK_REPO_GREP}"; then
    printf '%s' 'enable-search+'
    if [[ -z "${query//[[:space:]]/}" ]] ||
      fzf --filter="${query}" --delimiter=/ --with-nth="${PICK_REPO_NTH}" <"${PICK_REPO_LIST}" | grep -q .; then
      printf 'change-with-nth(%s)+reload(cat "$PICK_REPO_LIST")+%s' \
        "${PICK_REPO_NTH}" "$(__pick_repo_prompt "${PICK_REPO_LOCAL}")"
    else
      printf 'change-with-nth(1..)+reload("$PICK_REPO_SELF" --fai-search {q})+%s' \
        "$(__pick_repo_prompt "${PICK_REPO_GITHUB}")"
    fi
  else
    printf 'disable-search+change-with-nth(1..)+reload("$PICK_REPO_SELF" --fai-grep {q})+%s' \
      "$(__pick_repo_prompt "${PICK_REPO_GREP}")"
  fi
}

# __pick_repo_on_query: run by fzf on every query edit; prints the fzf actions
# that rewrite a pasted URL, and pick the list: local while the query matches
# a local repo (or is empty), otherwise GitHub, re-searched on every edit.
__pick_repo_on_query() {
  local query="${FZF_QUERY}" rewritten
  # shellcheck disable=SC2016 # expanded by the shell fzf runs reload in
  local search='reload("$PICK_REPO_SELF" --fai-search {q})'
  if __pick_repo_in "${PICK_REPO_GREP}"; then
    # shellcheck disable=SC2016 # expanded by the shell fzf runs reload in
    printf '%s' 'reload("$PICK_REPO_SELF" --fai-grep {q})'
    return 0
  fi
  rewritten="$(__pick_repo_unurl "${query}")"
  if [[ "${rewritten}" != "${query}" ]]; then
    # the change it makes runs this again
    printf 'change-query(%s)' "${rewritten}"
    [[ -s "${PICK_REPO_LINK}" ]] && printf '+change-footer:Link: %s' "$(<"${PICK_REPO_LINK}")"
    return
  fi
  if [[ -z "${query//[[:space:]]/}" ]] ||
    fzf --filter="${query}" --delimiter=/ --with-nth="${PICK_REPO_NTH}" <"${PICK_REPO_LIST}" | grep -q .; then
    # shellcheck disable=SC2016 # expanded by the shell fzf runs reload in
    __pick_repo_in "${PICK_REPO_GITHUB}" &&
      printf 'change-with-nth(%s)+reload(cat "$PICK_REPO_LIST")+%s' \
        "${PICK_REPO_NTH}" "$(__pick_repo_prompt "${PICK_REPO_LOCAL}")"
  elif __pick_repo_in "${PICK_REPO_GITHUB}"; then
    printf '%s' "${search}"
  else
    # GitHub results are bare owner/repo lines, shown whole.
    printf 'change-with-nth(1..)+%s+%s' "${search}" "$(__pick_repo_prompt "${PICK_REPO_GITHUB}")"
  fi
  return 0
}

# __pick_repo_delete <dir>: run by fzf on CTRL-X. Show what deleting a local
# clone would lose (uncommitted changes, commits on no remote, stashes), ask,
# then delete it and drop it from $PICK_REPO_LIST.
__pick_repo_delete() {
  local dir="${1:-}" root="${HOME}/Projects/github.com" answer lost
  # Only ever a <root>/<owner>/<repo> directory, never a listed parent (ending in /)
  [[ "${dir}" == "${root}"/*/* && "${dir}" != */ && "${dir#"${root}"/*/}" != */* &&
    -n "${dir#"${root}"/*/}" && -d "${dir}" ]] || return 0
  printf '\nDelete %s?\n' "${dir#"${root}"/}"
  if [[ -d "${dir}/.git" ]]; then
    lost="$(git -C "${dir}" status --short 2>/dev/null)"
    [[ -n "${lost}" ]] && printf '\nUncommitted changes:\n%s\n' "${lost}"
    lost="$(git -C "${dir}" log --branches --not --remotes --oneline 2>/dev/null)"
    [[ -n "${lost}" ]] && printf '\nCommits on no remote:\n%s\n' "${lost}"
    lost="$(git -C "${dir}" stash list 2>/dev/null)"
    [[ -n "${lost}" ]] && printf '\nStashes:\n%s\n' "${lost}"
  fi
  read -r -p $'\nType y to delete: ' answer </dev/tty
  [[ "${answer}" == [yY] ]] || return 0
  rm -rf -- "${dir}"
  # drop the owner directory too once its last repo is gone
  rmdir -- "$(dirname "${dir}")" 2>/dev/null || true
  { grep -vxF -- "${dir}" "${PICK_REPO_LIST}" || true; } >"${PICK_REPO_LIST}.new"
  mv -- "${PICK_REPO_LIST}.new" "${PICK_REPO_LIST}"
}

# __pick_repo_on_delete: run by fzf on CTRL-X; prints the actions that delete
# the highlighted local clone. A GitHub search result or a grep hit is left
# alone.
__pick_repo_on_delete() {
  __pick_repo_in "${PICK_REPO_LOCAL}" || return 0
  # shellcheck disable=SC2016 # expanded by the shell fzf runs execute in
  printf '%s' 'execute("$PICK_REPO_SELF" --fai-delete {})+reload(cat "$PICK_REPO_LIST")'
}

# __pick_repo [fzf options...]: the repo picker, printing each picked
# directory's full path; see the header. fzf's bindings run this script again
# with the --fai-* flags at the bottom.
__pick_repo() {
  local root="${HOME}/Projects/github.com" link="${PICK_REPO_LINK:-}" own_link=""
  local list out rc line spec picked="" args=() arg ref="" dir
  if [[ -z "${link}" ]]; then
    link="$(mktemp)"
    own_link=1
  fi
  list="$(mktemp)"
  # Local paths show from github.com on: the field after the root's slashes.
  local nth="${root//[!\/]/}"
  nth="$((${#nth} + 1)).."
  # Every directory from the root down to the repos: the root and each owner
  # keep their trailing / (fd's), so the list shows github.com/ and <owner>/;
  # it is dropped from the path printed for a pick.
  {
    [[ -d "${root}" ]] && printf '%s/\n' "${root}"
    fd . "${root}" --type d --max-depth 1
    fd . "${root}" --type d --min-depth 2 --max-depth 2 | sed 's|/$||'
  } >"${list}"

  # Rewrite a URL in the initial query now, so --select-1 can still see it.
  # A prompt gets the local list's marker before its "> ".
  for arg in "$@"; do
    [[ "${arg}" == --prompt=*"> " ]] && arg="${arg%> } ${PICK_REPO_LOCAL}> "
    [[ "${arg}" == --query=* ]] &&
      arg="--query=$(PICK_REPO_LINK="${link}" __pick_repo_unurl "${arg#--query=}")"
    args+=("${arg}")
  done
  [[ -s "${link}" ]] && args+=("--footer=Link: $(<"${link}")")

  # shellcheck disable=SC2094,SC2016 # fzf only reads the list; $vars expand in fzf's shell
  out="$(PICK_REPO_LIST="${list}" PICK_REPO_LINK="${link}" \
    PICK_REPO_SELF="${self}" PICK_REPO_NTH="${nth}" \
    fzf <"${list}" --with-shell='bash -c' --ansi \
      --delimiter=/ --with-nth="${nth}" --prompt="Repo ${PICK_REPO_LOCAL}> " \
      --preview='"$PICK_REPO_SELF" --fai-preview {}' \
      --bind='start,change:transform:"$PICK_REPO_SELF" --fai-on-query' \
      --bind='ctrl-t:transform:"$PICK_REPO_SELF" --fai-on-toggle' \
      --bind='ctrl-x:transform:"$PICK_REPO_SELF" --fai-on-delete' \
      ${args[@]+"${args[@]}"})"
  rc=$?
  rm -f "${list}"

  # A grep hit becomes its repo's path, keeping its path:line; a GitHub pick
  # is a bare owner/repo; any other line (a local path, or a line from
  # --expect or print) passes through untouched.
  if ((rc == 0)); then
    while IFS= read -r line; do
      if [[ "${line}" =~ ^([^/]+/[^/]+)/([^:]+):([0-9]+): ]]; then
        ref="${BASH_REMATCH[2]}:${BASH_REMATCH[3]}"
        line="${root}/${BASH_REMATCH[1]}"
      elif [[ "${line}" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]]; then
        line="${root}/${line}"
        if [[ ! -d "${line}/.git" ]]; then
          gh repo clone "${BASH_REMATCH[0]}" "${line}" >&2 || rc=1
        fi
      fi
      [[ "${line}" == /?*/ ]] && line="${line%/}"
      [[ "${line}" == /* ]] && picked+="${line,,}"$'\n'
      printf '%s\n' "${line}"
    done <<<"${out}"
  fi

  # Keep a GitHub link only if it points into a repo that was picked; any
  # other link is kept whatever was picked.
  spec="$(__pick_repo_spec "$(<"${link}")")"
  [[ -z "${spec}" || "${picked}" == *"/${spec,,}"$'\n'* ]] || : >"${link}"
  if [[ -n "${ref}" ]]; then
    spec="$(<"${link}")"
    printf '%s\n' "${spec:+${spec} }${ref}" >"${link}"
  fi
  [[ -n "${own_link}" ]] && rm -f "${link}"
  return "${rc}"
}

# __fai_icon <agent>: the Nerd Font icon an agent shows as in fai's prompt
__fai_icon() {
  case "${1}" in
  claude) printf '\uec82' ;;  # cod-claude
  cloud) printf '\uebaa' ;;   # cod-cloud
  copilot) printf '\uec1e' ;; # cod-copilot
  pi) printf '\ue22c' ;;      # fae-pi
  *) printf '%s' "${1}" ;;
  esac
}

# __fai_prefill <rex|tmux> <block|pane> <text>: wait for the agent to take over
# the terminal and settle (the screen unchanged across two samples), then type
# <text> into its prompt without pressing Enter. Text with a newline goes as a
# bracketed paste, so its newlines don't send the prompt. Gives up after ~30s,
# e.g. while a folder-trust dialog waits on an answer.
__fai_prefill() {
  local kind="${1}" target="${2}" text="${3}" prev="" cur cmd i
  for ((i = 0; i < 60; i++)); do
    sleep 0.5
    if [[ "${kind}" == rex ]]; then
      cmd="$(rex block call -b "${target}" process 2>/dev/null |
        jq -r '.foreground.argv0 // .foreground.name // empty')"
      cur="$(rex capture -b "${target}" 2>/dev/null)" || return 0
    else
      cmd="$(tmux display-message -p -t "${target}" '#{pane_current_command}' 2>/dev/null)" || return 0
      cur="$(tmux capture-pane -p -t "${target}" 2>/dev/null)" || return 0
    fi
    [[ -z "${cmd}" || "${cmd}" =~ ^-?(bash|zsh|fish|sh)$ ]] && continue
    if [[ -n "${cur//[[:space:]]/}" && "${cur}" == "${prev}" && "${cur,,}" != *trust* ]]; then
      if [[ "${text}" != *$'\n'* ]]; then
        if [[ "${kind}" == rex ]]; then
          rex send -b "${target}" "${text}"
        else
          tmux send-keys -t "${target}" -l "${text}"
        fi
      elif [[ "${kind}" == rex ]]; then
        rex send -b "${target}" $'\e[200~'"${text}"$'\e[201~'
      else
        # -p pastes bracketed when the agent asked for it, as agents do.
        printf '%s' "${text}" | tmux load-buffer -b fai-prefill - &&
          tmux paste-buffer -p -d -b fai-prefill -t "${target}"
      fi
      return 0
    fi
    prev="${cur}"
  done
}

# __fai_prefill_bg <args...>: __fai_prefill, detached so it outlives fai and
# the picker's floating layer
__fai_prefill_bg() {
  nohup "${self}" --fai-prefill "$@" >/dev/null 2>&1 &
  disown
}

# __fai_open_cloud <rex|tmux> <block|pane>: wait for `claude --cloud` to print
# its claude.ai/code session URL, then open it in the browser. URLs already on
# screen when it starts (a CTRL-O run's scrollback) don't count. Gives up
# after ~2m.
__fai_open_cloud() {
  local kind="${1}" target="${2}" re='https://claude\.ai/code/session_[A-Za-z0-9]+'
  local seen cur new i
  __fai_urls() {
    if [[ "${kind}" == rex ]]; then
      rex capture -b "${target}" --unwrap 2>/dev/null
    else
      tmux capture-pane -p -J -S - -t "${target}" 2>/dev/null
    fi | grep -oE "${re}" | sort -u
  }
  seen="$(__fai_urls)"
  for ((i = 0; i < 120; i++)); do
    sleep 1
    cur="$(__fai_urls)"
    new="$(comm -13 <(printf '%s\n' "${seen}") <(printf '%s\n' "${cur}") | grep -m1 .)"
    if [[ -n "${new}" ]]; then
      open "${new}"
      return 0
    fi
  done
}

# __fai_open_cloud_bg <args...>: __fai_open_cloud, detached like
# __fai_prefill_bg
__fai_open_cloud_bg() {
  nohup "${self}" --fai-open-cloud "$@" >/dev/null 2>&1 &
  disown
}

# __fai_rex_window <dir>: print "<window> <block>" for a window in
# $REX_SESSION named after <dir> with a block working in <dir> (or below it),
# that block being the one to split; fail if there is none. The name alone
# could be another owner's repo of the same name.
__fai_rex_window() {
  local dir="${1}" name win block cwd
  name="$(basename "${dir}")"
  while read -r win block; do
    cwd="$(rex block call -b "${block}" process 2>/dev/null |
      jq -r '.foreground.cwd // .ancestors[0].cwd // empty')"
    if [[ "${cwd}" == "${dir}" || "${cwd}" == "${dir}"/* ]]; then
      printf '%s %s\n' "${win}" "${block}"
      return 0
    fi
  done < <(rex window ls -s "${REX_SESSION}" --json --short=false 2>/dev/null |
    jq -r --arg n "${name}" '.windows[] | select(.label == $n)
      | "\(.window_id) \(.focused_block_id, (.layers[] | select(.kind == "tiled")
        | .blocks[].block_id))"')
  return 1
}

# __fai_launch <dir> <agent> <link> <prefill> <run-here> <cmd...>: start the
# agent's command in <dir>: here when <run-here> is 1 (or outside tmux and
# Rex), else in the repo's tmux or Rex window, as fai's header describes.
# <link> is the picked link (for tmux's @url); <prefill> is typed into the
# agent's prompt once it starts.
__fai_launch() {
  local dir="${1}" agent="${2}" link="${3}" url="${4}" here="${5}" win pane out
  shift 5
  # tmux first: a tmux started inside Rex inherits REX_SESSION too
  if [[ "${here}" == 1 || (-z "${TMUX:-}" && -z "${REX_SESSION:-}") ]]; then
    if [[ -n "${url}" ]]; then
      if [[ -n "${TMUX_PANE:-}" ]]; then
        __fai_prefill_bg tmux "${TMUX_PANE}" "${url}"
      elif [[ -n "${REX_BLOCK:-}" && -z "${TMUX:-}" ]]; then
        # A tmux popup has TMUX but no TMUX_PANE; a REX_BLOCK there is
        # the block running tmux, not this agent.
        __fai_prefill_bg rex "${REX_BLOCK}" "${url}"
      else
        echo "fai: paste this into ${agent}: ${url}" >&2
      fi
    fi
    if [[ "${agent}" == cloud ]]; then
      if [[ -n "${TMUX_PANE:-}" ]]; then
        __fai_open_cloud_bg tmux "${TMUX_PANE}"
      elif [[ -n "${REX_BLOCK:-}" && -z "${TMUX:-}" ]]; then
        __fai_open_cloud_bg rex "${REX_BLOCK}"
      fi
    fi
    (cd "${dir}" && "$@")
  elif [[ -n "${TMUX:-}" ]]; then
    # A window fai already opened for this repo (marked by @fai_dir) gets a
    # split instead of a second window.
    win="$(tmux list-windows -a -F '#{window_id} #{@fai_dir}' |
      awk -v d="${dir}" 'substr($0, index($0, " ") + 1) == d { print $1; exit }')"
    if [[ -n "${win}" ]]; then
      pane="$(tmux split-window -t "${win}" -c "${dir}" -P -F '#{pane_id}' \
        -- "$@")" || return
      tmux select-window -t "${win}"
    else
      pane="$(tmux new-window -c "${dir}" -n "$(basename "${dir}")" -P -F '#{pane_id}' \
        -- "$@")" || return
      tmux set-option -w -t "${pane}" @fai_dir "${dir}"
    fi
    # @url: the window's links its tab to the repo; the pane's is the deep
    # link it was opened with. Both are listed by prefix C-u (fzf-urls).
    if [[ "${dir}" == "${HOME}/Projects/github.com/"*/* ]]; then
      tmux set-option -w -t "${pane}" @url "https://github.com/${dir#"${HOME}/Projects/github.com/"}"
    fi
    # The link may be a URL, a grep hit's path:line, or a URL then a path:line.
    [[ "${link}" == http* ]] && tmux set-option -p -t "${pane}" @url "${link%% *}"
    [[ -n "${url}" ]] && __fai_prefill_bg tmux "${pane}" "${url}"
    [[ "${agent}" == cloud ]] && __fai_open_cloud_bg tmux "${pane}"
  else
    local block anchor
    # A window for this repo (named after it, with a block working in it)
    # gets a split instead of a second window.
    if anchor="$(__fai_rex_window "${dir}")"; then
      read -r win anchor <<<"${anchor}"
      out="$(rex split -s "${REX_SESSION}" -b "${anchor}" -c "${dir}" --json \
        -- "$@")" || return
      block="$(jq -r '.block_id // .block_ids[0]' <<<"${out}")"
    else
      out="$(rex window new -s "${REX_SESSION}" "$(basename "${dir}")" -c "${dir}" --json \
        -- "$@")" || return
      win="$(jq -r .window_id <<<"${out}")"
      block="$(jq -r '.block_ids[0]' <<<"${out}")"
    fi
    [[ -n "${url}" ]] && __fai_prefill_bg rex "${block}" "${url}"
    [[ "${agent}" == cloud ]] && __fai_open_cloud_bg rex "${block}"
    # The Rex app keeps its own selected tab, so ask it to show the new one.
    # It only takes this with Remote Control on (Settings > Rex Server).
    # shellcheck disable=SC1010 # `do` is rex's subcommand, not the keyword
    rex do session.select session_id="${REX_SESSION}" window_id="${win}" >/dev/null 2>&1 || true
  fi
}

fai() {
  # Agents offered; the first installed one is the default.
  local all=(claude cloud copilot pi) agents=() icons=() agent cmd query=() out lines key=enter dir link url here
  # Text to paste into the agent's prompt; kept out of the agents' environment.
  local text="${FAI_TEXT:-}" footer=()
  unset FAI_TEXT
  local select=(--select-1)
  [[ -n "${FAI_PICK:-}" ]] && select=()
  [[ -n "${FAI_AGENTS:-}" ]] && read -ra all <<<"${FAI_AGENTS}"
  for agent in "${all[@]}"; do
    cmd="${agent}"
    [[ "${agent}" == cloud ]] && cmd=claude
    if command -v "${cmd}" >/dev/null 2>&1; then
      agents+=("${agent}")
      icons+=("$(__fai_icon "${agent}")")
    fi
  done
  if [[ ${#agents[@]} -eq 0 ]]; then
    echo "fai: none of '${all[*]}' is installed" >&2
    return 1
  fi
  while [[ $# -gt 0 && "${1}" != -* ]]; do
    query+=("${1}")
    shift
  done
  [[ "${1:-}" == -- ]] && shift

  # The prompt starts with the agent's icon; find it in the icons to print
  # the agent it stands for, or to swap it for another agent's.
  # shellcheck disable=SC2016 # expanded by the shell fzf runs transform in
  local find='a=($FAI_AGENTS) ic=($FAI_ICONS) cur=${FZF_PROMPT%%[ >]*} i=0
    while ((i < ${#ic[@]})) && [[ ${ic[i]} != "$cur" ]]; do ((i++)); done'
  # Switch to the first installed agent in $want; nothing if none is.
  # shellcheck disable=SC2016
  local choose='
    for t in $want; do
      for ((j = 0; j < ${#a[@]}; j++)); do
        if [[ ${a[j]} == "$t" ]]; then
          printf "change-prompt:%s" "${ic[j]}${FZF_PROMPT#"$cur"}"
          exit 0
        fi
      done
    done'
  # ALT-C is claude, or the cloud agent when claude is already chosen.
  # shellcheck disable=SC2016
  local claude="${find}"'
    want="claude cloud"; [[ ${a[i]} == claude ]] && want="cloud claude"'"${choose}"
  # shellcheck disable=SC2016
  local accept="${find}"'
    printf "print(%s)+print(%s)+accept" "$key" "${a[i]}"'

  if [[ -n "${text}" ]]; then
    local first="${text%%$'\n'*}"
    [[ "${first}" != "${text}" ]] && first+=" …"
    footer=(--footer="Text: ${first:0:200}")
  fi

  link="$(mktemp)"
  out="$(PICK_REPO_LINK="${link}" FAI_AGENTS="${agents[*]}" FAI_ICONS="${icons[*]}" __pick_repo \
    --multi --prompt="${icons[0]}> " --query="${query[*]}" ${select[@]+"${select[@]}"} \
    --header='ENTER: open / CTRL-O: run here / TAB: mark / ALT-C: claude (again: cloud) / ALT-G: copilot / ALT-P: pi / CTRL-T: grep / CTRL-X: delete' \
    --bind="alt-c:transform:${claude}" \
    --bind="alt-g:transform:${find}; want=copilot; ${choose}" \
    --bind="alt-p:transform:${find}; want=pi; ${choose}" \
    --bind="enter:transform:key=enter; ${accept}" \
    --bind="ctrl-o:transform:key=ctrl-o; ${accept}" \
    ${footer[@]+"${footer[@]}"})"
  url="$(<"${link}")"
  rm -f "${link}"
  # ESC or CTRL-C: nothing picked, nothing opened
  [[ -n "${out}" ]] || return 0
  link="${url}" # kept for tmux's @url; the cloud agent clears url below

  # key, agent, then the picked dirs -- or just a dir when --select-1 skipped
  # the picker
  local dirs=()
  mapfile -t lines <<<"${out}"
  if [[ "${lines[0]}" != /* && ${#lines[@]} -ge 3 ]]; then
    key="${lines[0]}"
    agent="${lines[1]}"
    dirs=("${lines[@]:2}")
  else
    agent="${agents[0]}"
    dirs=("${lines[@]}")
  fi
  for dir in "${dirs[@]}"; do
    [[ -d "${dir}" ]] || return 1
  done
  cmd=("${agent}")
  if [[ "${agent}" == cloud ]]; then
    cmd=(claude --cloud)
    if [[ $# -eq 0 ]]; then
      local task
      read -rep "Task for claude.ai/code: " -i "${url}" task || return
      [[ -n "${task//[[:space:]]/}${text//[[:space:]]/}" ]] || return 1
      [[ -n "${text}" ]] && task+="${task:+$'\n\n'}${text}"
      set -- "${task}"
    fi
    url=""
    text=""
  fi
  # What the agent's prompt starts with: the link, then any text below it
  [[ -n "${text}" ]] && url+="${url:+$'\n\n'}${text}"

  # Outside tmux and Rex there is only here, so only the first dir.
  if [[ -z "${TMUX:-}" && -z "${REX_SESSION:-}" && ${#dirs[@]} -gt 1 ]]; then
    echo "fai: outside tmux and Rex, only ${dirs[0]} gets an agent" >&2
    dirs=("${dirs[0]}")
  fi
  # CTRL-O runs the first here, last, since it holds this terminal; the
  # others open in windows first.
  for dir in "${dirs[@]:1}"; do
    __fai_launch "${dir}" "${agent}" "${link}" "${url}" 0 "${cmd[@]}" "$@"
  done
  [[ "${key}" == ctrl-o ]] && here=1 || here=0
  __fai_launch "${dirs[0]}" "${agent}" "${link}" "${url}" "${here}" "${cmd[@]}" "$@"
}

# The --fai-* flags are this script run again: by fzf's bindings in the
# picker, or detached by __fai_prefill_bg and __fai_open_cloud_bg.
case "${1:-}" in
--fai-on-query) __pick_repo_on_query ;;
--fai-on-delete) __pick_repo_on_delete ;;
--fai-on-toggle) __pick_repo_on_toggle ;;
--fai-grep) __pick_repo_grep "${2:-}" ;;
--fai-preview) __pick_repo_preview "${2:-}" ;;
--fai-search) __pick_repo_search "${2:-}" ;;
--fai-delete) __pick_repo_delete "${2:-}" ;;
--fai-prefill)
  shift
  __fai_prefill "$@"
  ;;
--fai-open-cloud)
  shift
  __fai_open_cloud "$@"
  ;;
*) fai "$@" ;;
esac

