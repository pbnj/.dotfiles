#!/usr/bin/env bash

# Author: Peter Benjamin
# Description: Pick URL(s) from a tmux pane's or a Rex block's scrollback with
#              fzf and open them. Newest first.
#              Linear issue IDs (ENG-123) are listed too, as their issue URL,
#              when their prefix is a team key from `linear team list`.
#              GitHub references are listed too, as their issue URL (GitHub
#              redirects it to the PR when the number is one): owner/repo#123
#              as written, and repo#123 when a clone of repo is under
#              ~/Projects/github.com/<owner>/, once per owner.
#              tmux keeps OSC 8 hyperlink targets (apps like Claude Code show a
#              label and hide the URL in the escape), so those are listed too.
#              Rex's captures don't carry them, so there only URLs shown as
#              text are found. A label an app truncated with "…" is skipped.
#              Full-screen apps (alternate screen) keep their own scrollback,
#              so only what they currently show is visible.
#              In tmux, the pane's (else its window's) @url option, if set, is
#              listed first.
# Dependencies: brew install fzf jq; the linear CLI, logged in (optional:
#               without it only URLs are listed)
# Usage: fzf-urls [PANE|BLOCK]
#        A tmux pane (%3) or a Rex block (block:...). Defaults to TMUX_PANE in
#        tmux, else REX_BLOCK.
#        tmux: bind with run-shell -b, passing '#{pane_id}'; the picker opens
#        in a tmux popup.
#        Rex: bind to a floating layer, passing the block that was focused, so
#        the picker closes once URLs are opened.

set -euo pipefail
[[ "${DEBUG:-}" == "true" ]] && set -x

target="${1:-}"
if [[ -z "${target}" ]]; then
  if [[ -n "${TMUX:-}" && -n "${TMUX_PANE:-}" ]]; then
    target="${TMUX_PANE}"
  else
    target="${REX_BLOCK:-}"
  fi
fi

# capture: the target's scrollback, joined lines, oldest first
capture() {
  case "${target}" in
  %*) tmux capture-pane -epJS- -t "${target}" ;;
  block:*) rex capture --unwrap -b "${target}" ;;
  *)
    echo "fzf-urls: not a tmux pane or Rex block: '${target}'" >&2
    return 1
    ;;
  esac
}

if [[ "${2:-}" == "--list" ]]; then
  # The default Linear workspace's slug for the URL, and its space-separated
  # team keys. They rarely change, so they're cached for a day; the two linear
  # calls run at once when the cache is refreshed.
  linear_cache="${XDG_CACHE_HOME:-${HOME}/.cache}/fzf-urls/linear"
  if [[ -z "$(find "${linear_cache}" -mmin -1440 2>/dev/null)" ]]; then
    mkdir -p "${linear_cache%/*}"
    tmp="$(mktemp "${linear_cache}.XXXXXX")"
    linear team list --json >"${tmp}.teams" 2>/dev/null &
    linear auth list 2>/dev/null | awk '$1 == "*" { print $2 }' >"${tmp}" || true
    wait $! || true
    if [[ -s "${tmp}" && -s "${tmp}.teams" ]]; then
      jq -r '[.[].key] | join(" ")' "${tmp}.teams" >>"${tmp}" 2>/dev/null || true
      mv "${tmp}" "${linear_cache}"
    fi
    rm -f "${tmp}" "${tmp}.teams"
  fi
  { read -r linear_workspace && read -r linear_keys; } <"${linear_cache}" 2>/dev/null || true
  [[ -n "${linear_workspace:-}" ]] || linear_workspace="" linear_keys=""

  # Space-separated owner/repo of every local clone, for repo#123.
  shopt -s nullglob
  clones=("${HOME}"/Projects/github.com/*/*/)
  shopt -u nullglob
  clones=("${clones[@]%/}")
  clones=("${clones[@]#"${HOME}"/Projects/github.com/}")
  github_repos="${clones[*]-}"

  # One row per URL: the URL, then a tab and where it came from (@url, or the
  # Linear ID or GitHub reference it was built from). Lines are read newest
  # first, and the first row for each URL is kept.
  {
    if [[ "${target}" == %* ]]; then
      url="$(tmux display-message -p -t "${target}" '#{@url}')"
      [[ -n "${url}" ]] && printf '%s\t@url\n' "${url}"
    fi
    capture |
    perl -e 'print reverse <>' |
    LINEAR_KEYS="${linear_keys}" LINEAR_WORKSPACE="${linear_workspace}" \
      GITHUB_REPOS="${github_repos}" perl -ne '
      BEGIN {
        %keys = map { $_ => 1 } split " ", $ENV{LINEAR_KEYS};
        # Lowercased repo name => owner/repo of each clone of it.
        push @{ $clones{lc((split m{/})[1])} }, $_ for split " ", $ENV{GITHUB_REPOS};
      }
      # OSC 8 hyperlink targets, then strip escapes to read the text. A target
      # is taken as the app sent it, except that it ends at "|" or a
      # box-drawing border, which apps that link URLs in text can sweep in.
      print "$1\n" while /\e\]8;[^;\a\e]*;(https?:\/\/(?:(?!\xe2[\x94\x95])[^\a\e|])+)/g;
      s/\e\][^\a\e]*(?:\a|\e\\)//g;
      s/\e\[[0-9;:?<=>]*[ -\/]*[@-~]//g;
      # A URL stops at whitespace, quotes, brackets, backticks, "|", and the
      # box-drawing borders TUIs draw (U+2500-U+257F: \xe2\x94 or \xe2\x95).
      for (/(https?:\/\/(?:(?!\xe2[\x94\x95])[^\s\x27"<>()\[\]`|])+)/g) {
        s/[.,;:!?]+$//;
        print "$_\n" unless /\xe2\x80\xa6$/;
      }
      # An ID inside a URL or a longer word is skipped.
      while (/(?<![\w\/.-])([A-Z][A-Z0-9]*)-([0-9]+)(?![\w-])/g) {
        print "https://linear.app/$ENV{LINEAR_WORKSPACE}/issue/$1-$2\t$1-$2\n" if $keys{$1};
      }
      # GitHub references: owner/repo#123, or repo#123 for a local clone. A
      # reference inside a URL, a path or a longer word is skipped.
      while (/(?<![\w\/.#-])(?:([A-Za-z0-9][A-Za-z0-9-]*)\/)?([\w.-]+)#([0-9]+)(?![\w-])/g) {
        my ($o, $r, $n) = ($1, $2, $3);
        my @repos = defined $o ? ("$o/$r") : @{ $clones{lc $r} || [] };
        print "https://github.com/$_/issues/$n\t", (defined $o ? "$o/" : ""), "$r#$n\n" for @repos;
      }
    '
  } |
    awk -F '\t' '!seen[$1]++'
  exit
fi

capture >/dev/null

popup=()
[[ "${target}" == %* ]] && popup=(--tmux 'center,80%')

fzf \
  --bind "start:reload:'$0' '${target}' --list" \
  --bind "enter:become:open {+1}" \
  --delimiter=$'\t' \
  --multi \
  --prompt='URL(s)> ' \
  --header='<TAB>: select  <ENTER>: open' \
  --reverse \
  ${popup[@]+"${popup[@]}"} || true

# vim:sts=2:ts=2:sw=2:et:
