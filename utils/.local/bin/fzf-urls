#!/usr/bin/env bash

# Author: Peter Benjamin
# Description: Pick URL(s) from a tmux pane's or a Rex block's scrollback with
#              fzf and open them. Newest first. Without a flag, ENTER opens
#              each in a split beside the pane or block, in a terminal viewer:
#              a Linear issue with `linear issue view`, a GitHub PR or issue
#              with `gh pr view` / `gh issue view` (its checks tab with
#              `gh pr checks`), a repo with `gh repo view`,
#              a Jira issue or a Confluence page with `twg` (Atlassian's
#              Teamwork Graph CLI, rendered as Markdown with bat); any other
#              URL, and every URL on CTRL-B, opens in the browser. With a flag,
#              ENTER opens the browser.
#              The preview pane shows the highlighted URL with the same
#              viewer (a PR or issue without its comments); CTRL-/ toggles it.
#              Linear issue IDs (ENG-123) are listed too, as their issue URL,
#              when their prefix is a team key from `linear team list`.
#              Jira issue keys (PROJ-123) are listed too, as their browse URL,
#              when their prefix is a Jira project key from `twg`. A key
#              that is both a Linear team and a Jira project is listed as both.
#              GitHub references are listed too, as their issue URL (GitHub
#              redirects it to the PR when the number is one): owner/repo#123
#              as written, and repo#123 when a clone of repo is under
#              ~/Projects/github.com/<owner>/, once per owner.
#              tmux keeps OSC 8 hyperlink targets (apps like Claude Code show a
#              label and hide the URL in the escape), so those are listed too.
#              Rex's captures don't carry them, so there only URLs shown as
#              text are found. A label an app truncated with "…" is skipped.
#              Full-screen apps (alternate screen) keep their own scrollback,
#              so only what they currently show is visible.
#              In tmux, the pane's (else its window's) @url option, if set, is
#              listed first.
# Dependencies: brew install fzf jq; the linear CLI, logged in (optional:
#               without it only URLs are listed); twg, logged in, to view
#               Jira and Confluence (optional: without it they open in the
#               browser); bat (optional) to color Markdown
# Usage: fzf-urls [--url|--linear|--jira|--confluence|--repo|--pr|--checks]
#                 [PANE|BLOCK]
#        fzf-urls --open-split PANE|BLOCK URL... (ENTER without a flag)
#        fzf-urls --preview URL (fzf's preview)
#        fzf-urls --view-jira KEY [--comments] | --view-confluence URL|ID
#        (the Jira and Confluence viewers)
#        A tmux pane (%3) or a Rex block (block:...). Defaults to TMUX_PANE in
#        tmux, else REX_BLOCK.
#        A flag narrows the list to one kind, each listed once; when only one
#        is found, it opens without showing the picker:
#        --url     any URL found as is (not built from an issue ID or
#                  reference)
#        --linear  Linear issues: issue URLs and issue IDs
#        --jira    Jira issues: browse URLs and issue keys
#        --confluence  Confluence pages and blog posts
#        --repo    GitHub repos, from any GitHub URL or reference
#        --pr      GitHub PRs, from PR URLs and references (a reference to an
#                  issue opens the issue: GitHub redirects /pull/N to it)
#        --checks  the checks tab of those PRs
#        With --linear, --jira or --confluence, ENTER (and a single match)
#        views in a split as without a flag, and CTRL-B opens the browser.
#        tmux: bind with run-shell -b, passing '#{pane_id}'; the picker opens
#        in a tmux popup.
#        Rex: bind to a floating layer, passing the block that was focused, so
#        the picker closes once URLs are opened.

set -euo pipefail
[[ "${DEBUG:-}" == "true" ]] && set -x

# viewer <url>: set view_script and view_args to a terminal viewer for the
# URL: bash code and its positional args. Returns 1 when there is none.
# shellcheck disable=SC2016 # $1 and $2 expand in the viewer's bash
viewer() {
  local url="${1}" re
  view_args=()
  re='^https://linear\.app/[^/]+/issue/([A-Z][A-Z0-9]*-[0-9]+)'
  if [[ "${url}" =~ ${re} ]]; then
    view_script='linear issue view --no-pager "$1"'
    view_args=("${BASH_REMATCH[1]}")
    return 0
  fi
  # Jira and Confluence, viewed by this script with twg (see jira() and
  # confluence() below), so the viewer gets this script's path as $1.
  if command -v twg >/dev/null; then
    re='^https://[^/]+\.atlassian\.net/(browse/|.*[?&]selectedIssue=)([A-Z][A-Z0-9_]*-[0-9]+)([?#&/]|$)'
    if [[ "${url}" =~ ${re} ]]; then
      view_script='"$1" --view-jira "$2" --comments'
      view_args=("${self}" "${BASH_REMATCH[2]}")
      return 0
    fi
    re='^https://[^/]+\.atlassian\.net/wiki/(spaces/[^/]+/(pages|blog/[0-9/]+)/[0-9]+|.*[?&]pageId=[0-9]+|x/)'
    if [[ "${url}" =~ ${re} ]]; then
      view_script='"$1" --view-confluence "$2"'
      view_args=("${self}" "${url}")
      return 0
    fi
  fi
  re='^https://github\.com/([A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+)(/([a-z]+)/([0-9]+)(/([a-z]+))?)?/?([?#].*)?$'
  [[ "${url}" =~ ${re} ]] || return 1
  view_args=("${BASH_REMATCH[1]%.git}" "${BASH_REMATCH[4]}")
  case "${BASH_REMATCH[3]}:${BASH_REMATCH[6]}" in
  :)
    view_script='gh repo view "$1"'
    view_args=("${view_args[0]}")
    ;;
  pull:checks) view_script='gh pr checks "$2" -R "$1"' ;;
  pull:*) view_script='gh pr view "$2" -R "$1" --comments' ;;
  # A reference is listed as an issue URL even when it is a PR.
  issues:) view_script='gh pr view "$2" -R "$1" --comments 2>/dev/null ||
    gh issue view "$2" -R "$1" --comments' ;;
  *) return 1 ;;
  esac
  return 0
}

# open_split <url...>: open each URL in a split beside the target, viewed with
# viewer(): in a Rex block, a best-fit split (rex-best-fit: along its longer
# side); in tmux, to the right. A URL without a viewer opens in the browser.
open_split() {
  local url dir=right shell
  shell="$(command -v bash)"
  if [[ "${target}" == block:* ]]; then
    dir="$(rex-best-fit "${target}" 2>/dev/null)" || dir=right
  fi
  for url in "$@"; do
    if ! viewer "${url}"; then
      open "${url}"
      continue
    fi
    # Keep the output on screen until a key is pressed; the block scrolls
    # it, so no pager.
    view_script="export GH_PAGER=cat PAGER=cat; ${view_script}
      ((\$? == 130)) || read -rsn1 -p 'Press any key to close'"
    case "${target}" in
    %*)
      tmux split-window -h -t "${target}" -- \
        "${shell}" -lc "${view_script}" bash ${view_args[@]+"${view_args[@]}"}
      ;;
    *)
      rex split -b "${target}" --split "${dir}" --shell=none --label view -- \
        "${shell}" -lc "${view_script}" bash ${view_args[@]+"${view_args[@]}"} >/dev/null
      ;;
    esac
  done
}

# md: color Markdown on stdin with bat, when it's installed.
md() {
  if command -v bat >/dev/null; then
    bat --plain --paging=never --color=always --language=md
  else
    cat
  fi
}

# jira <key> [--comments]: a Jira issue as Markdown: its fields, description
# and, with --comments, its comments.
jira() {
  local comments=false
  [[ "${2:-}" == "--comments" ]] && comments=true
  twg -o json --output-summary none jira workitem get "${1}" ${2:+--comments} |
    jq -r --argjson comments "${comments}" "${jira_jq}" | md
}
# The issue's description and comments are ADF (Atlassian Document Format)
# JSON, turned into Markdown enough to read.
# shellcheck disable=SC2016 # $comments and $m are jq's
jira_jq='# ADF (Atlassian Document Format) to Markdown, enough to read
def adf:
  def kids: (.content // []) | map(adf) | join("");
  if type == "string" then .
  elif type == "array" then map(adf) | join("")
  elif type != "object" then ""
  elif .type == "text" then
    (.marks // []) as $m
    | if any($m[]; .type == "link") then "[\(.text)](\(first($m[] | select(.type == "link")).attrs.href))"
      elif any($m[]; .type == "code") then "\u0060\(.text)\u0060"
      elif any($m[]; .type == "strong") then "**\(.text)**"
      else .text end
  elif .type == "hardBreak" then "\n"
  elif .type == "mention" or .type == "emoji" or .type == "status" or .type == "date" then
    (.attrs.text // .attrs.shortName // .attrs.timestamp // "")
  elif .type == "inlineCard" or .type == "blockCard" or .type == "embedCard" then (.attrs.url // "")
  elif .type == "heading" then ("#" * (.attrs.level // 1)) + " " + kids + "\n\n"
  elif .type == "paragraph" then kids + "\n\n"
  elif .type == "listItem" then "- " + (kids | rtrimstr("\n") | rtrimstr("\n") | gsub("\n(?=.)"; "\n  ")) + "\n"
  elif .type == "bulletList" or .type == "orderedList" then kids + "\n"
  elif .type == "codeBlock" then "\u0060\u0060\u0060\(.attrs.language // "")\n" + kids + "\n\u0060\u0060\u0060\n\n"
  elif .type == "blockquote" or .type == "panel" then (kids | rtrimstr("\n\n") | split("\n") | map("> " + .) | join("\n")) + "\n\n"
  elif .type == "rule" then "---\n\n"
  elif .type == "tableRow" then "| " + ((.content // []) | map(adf | rtrimstr("\n\n") | gsub("\n+"; " ")) | join(" | ")) + " |\n"
  elif .type == "table" then kids + "\n"
  else kids end;
(.data // .) | (if type == "array" then .[0] else . end)
| "# \(.key): \(.summary)\n",
  ([["Status", .status.name], ["Type", .issuetype.name], ["Priority", .priority.name],
    ["Assignee", .assignee.displayName // "Unassigned"], ["Parent", .parent.key]]
   | map(select(.[1] != null) | "**\(.[0]):** \(.[1])") | join(" | ")),
  (if (.labels // []) != [] then "**Labels:** \(.labels | join(", "))" else empty end),
  "**Reporter:** \(.reporter.displayName // "-") | **Created:** \(.created[:10]) | **Updated:** \(.updated[:10])\n",
  (.description | adf | rtrimstr("\n")),
  (if $comments and ((.comments // []) | length) > 0 then
     "\n## Comments\n",
     (.comments[] | "### \(.author.displayName) · \(.created[:16] | sub("T"; " "))\n\n\(.body | adf | rtrimstr("\n"))\n")
   else empty end)'

# confluence <url|id>: a Confluence page (or blog post) as Markdown: its
# title, last edit and body.
confluence() {
  twg -o json --output-summary none confluence content get "${1}" \
    --detail full --format md 2>/dev/null |
    jq -r '.data | (.title | gsub("&amp;"; "&") | gsub("&lt;"; "<") | gsub("&gt;"; ">")) as $t
      | "# \($t)\n",
        "**Updated:** \(.metadata.version.createdAt // "" | .[:10]) by \(.metadata.version.author.displayName // "-")\n",
        .body.value' | md
}

# preview <url>: the URL viewed with viewer() for fzf's preview pane, in
# color at the pane's width, or the URL itself when there is no viewer.
preview() {
  local url="${1}"
  if ! viewer "${url}"; then
    printf '%s\n' "${url}"
    return 0
  fi
  # The body says more than the comments in a glance.
  view_script="${view_script// --comments/}"
  GH_FORCE_TTY="${FZF_PREVIEW_COLUMNS:-100}" GH_PAGER=cat PAGER=cat \
    CLICOLOR_FORCE=1 FORCE_COLOR=1 \
    bash -c "${view_script}" bash ${view_args[@]+"${view_args[@]}"} 2>&1 ||
    printf '\nfzf-urls: no preview for %s\n' "${url}"
}

self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

case "${1:-}" in
--view-jira)
  jira "${2}" "${3:-}"
  exit
  ;;
--view-confluence)
  confluence "${2}"
  exit
  ;;
esac

if [[ "${1:-}" == "--preview" ]]; then
  preview "${2}"
  exit
fi

if [[ "${1:-}" == "--open-split" ]]; then
  target="${2}"
  shift 2
  open_split "$@"
  exit
fi

only=""
case "${1:-}" in
--url | --linear | --jira | --confluence | --repo | --pr | --checks)
  only="${1#--}"
  shift
  ;;
esac

target="${1:-}"
if [[ -z "${target}" ]]; then
  if [[ -n "${TMUX:-}" && -n "${TMUX_PANE:-}" ]]; then
    target="${TMUX_PANE}"
  else
    target="${REX_BLOCK:-}"
  fi
fi

# capture: the target's scrollback, joined lines, oldest first
capture() {
  case "${target}" in
  %*) tmux capture-pane -epJS- -t "${target}" ;;
  block:*) rex capture --unwrap -b "${target}" ;;
  *)
    echo "fzf-urls: not a tmux pane or Rex block: '${target}'" >&2
    return 1
    ;;
  esac
}

if [[ "${2:-}" == "--list" ]]; then
  # The default Linear workspace's slug for the URL, and its space-separated
  # team keys. They rarely change, so they're cached for a day; the two linear
  # calls run at once when the cache is refreshed.
  linear_cache="${XDG_CACHE_HOME:-${HOME}/.cache}/fzf-urls/linear"
  if [[ -z "$(find "${linear_cache}" -mmin -1440 2>/dev/null)" ]]; then
    mkdir -p "${linear_cache%/*}"
    tmp="$(mktemp "${linear_cache}.XXXXXX")"
    linear team list --json >"${tmp}.teams" 2>/dev/null &
    linear auth list 2>/dev/null | awk '$1 == "*" { print $2 }' >"${tmp}" || true
    wait $! || true
    if [[ -s "${tmp}" && -s "${tmp}.teams" ]]; then
      jq -r '[.[].key] | join(" ")' "${tmp}.teams" >>"${tmp}" 2>/dev/null || true
      mv "${tmp}" "${linear_cache}"
    fi
    rm -f "${tmp}" "${tmp}.teams"
  fi
  { read -r linear_workspace && read -r linear_keys; } <"${linear_cache}" 2>/dev/null || true
  [[ -n "${linear_workspace:-}" ]] || linear_workspace="" linear_keys=""

  # The Jira site's host for the URL, and its space-separated project keys,
  # from twg, cached for a day like Linear's. Projects come 100 a page.
  jira_cache="${XDG_CACHE_HOME:-${HOME}/.cache}/fzf-urls/jira"
  if command -v twg >/dev/null && [[ -z "$(find "${jira_cache}" -mmin -1440 2>/dev/null)" ]]; then
    mkdir -p "${jira_cache%/*}"
    tmp="$(mktemp "${jira_cache}.XXXXXX")"
    jira_site="" jira_keys="" start=0
    while page="$(twg -o json --output-summary none jira space list \
      --limit 100 --start-at "${start}" 2>/dev/null)"; do
      jira_site="$(jq -r '.request.site // empty' <<<"${page}")" || break
      jira_keys+=" $(jq -r '[.data.projects[].key] | join(" ")' <<<"${page}")" || break
      [[ "$(jq -r '.data.isLast' <<<"${page}")" == "false" ]] || break
      start=$((start + 100))
    done
    if [[ -n "${jira_site}" && -n "${jira_keys// /}" ]]; then
      printf '%s\n%s\n' "${jira_site}" "${jira_keys# }" >"${tmp}"
      mv "${tmp}" "${jira_cache}"
    fi
    rm -f "${tmp}"
  fi
  { read -r jira_site && read -r jira_keys; } <"${jira_cache}" 2>/dev/null || true
  [[ -n "${jira_site:-}" ]] || jira_site="" jira_keys=""

  # Space-separated owner/repo of every local clone, for repo#123.
  shopt -s nullglob
  clones=("${HOME}"/Projects/github.com/*/*/)
  shopt -u nullglob
  clones=("${clones[@]%/}")
  clones=("${clones[@]#"${HOME}"/Projects/github.com/}")
  github_repos="${clones[*]-}"

  # One row per URL: the URL, then a tab and where it came from (@url, or the
  # Linear ID or GitHub reference it was built from). Lines are read newest
  # first, and the first row for each URL is kept.
  {
    if [[ "${target}" == %* ]]; then
      url="$(tmux display-message -p -t "${target}" '#{@url}')"
      [[ -n "${url}" ]] && printf '%s\t@url\n' "${url}"
    fi
    capture |
    perl -e 'print reverse <>' |
    LINEAR_KEYS="${linear_keys}" LINEAR_WORKSPACE="${linear_workspace}" \
      JIRA_KEYS="${jira_keys}" JIRA_SITE="${jira_site}" GITHUB_REPOS="${github_repos}" perl -ne '
      BEGIN {
        %keys = map { $_ => 1 } split " ", $ENV{LINEAR_KEYS};
        %jira = map { $_ => 1 } split " ", $ENV{JIRA_KEYS};
        # Lowercased repo name => owner/repo of each clone of it.
        push @{ $clones{lc((split m{/})[1])} }, $_ for split " ", $ENV{GITHUB_REPOS};
      }
      # OSC 8 hyperlink targets, then strip escapes to read the text. A target
      # is taken as the app sent it, except that it ends at "|" or a
      # box-drawing border, which apps that link URLs in text can sweep in.
      print "$1\n" while /\e\]8;[^;\a\e]*;(https?:\/\/(?:(?!\xe2[\x94\x95])[^\a\e|])+)/g;
      s/\e\][^\a\e]*(?:\a|\e\\)//g;
      s/\e\[[0-9;:?<=>]*[ -\/]*[@-~]//g;
      # A URL stops at whitespace, quotes, brackets, backticks, "|", and the
      # box-drawing borders TUIs draw (U+2500-U+257F: \xe2\x94 or \xe2\x95).
      for (/(https?:\/\/(?:(?!\xe2[\x94\x95])[^\s\x27"<>()\[\]`|])+)/g) {
        s/[.,;:!?]+$//;
        print "$_\n" unless /\xe2\x80\xa6$/;
      }
      # Linear and Jira issue IDs. An ID inside a URL or a longer word is
      # skipped.
      while (/(?<![\w\/.-])([A-Z][A-Z0-9_]*)-([0-9]+)(?![\w-])/g) {
        print "https://linear.app/$ENV{LINEAR_WORKSPACE}/issue/$1-$2\t$1-$2\n" if $keys{$1};
        print "https://$ENV{JIRA_SITE}/browse/$1-$2\t$1-$2\n" if $jira{$1};
      }
      # GitHub references: owner/repo#123, or repo#123 for a local clone. A
      # reference inside a URL, a path or a longer word is skipped.
      while (/(?<![\w\/.#-])(?:([A-Za-z0-9][A-Za-z0-9-]*)\/)?([\w.-]+)#([0-9]+)(?![\w-])/g) {
        my ($o, $r, $n) = ($1, $2, $3);
        my @repos = defined $o ? ("$o/$r") : @{ $clones{lc $r} || [] };
        print "https://github.com/$_/issues/$n\t", (defined $o ? "$o/" : ""), "$r#$n\n" for @repos;
      }
    '
  } |
    awk -F '\t' -v OFS='\t' -v only="${only}" '
      only == "" { if (!seen[$1]++) print; next }
      # Any URL: as found, or @url; not one built from an ID or reference.
      only == "url" {
        if (($2 == "" || $2 == "@url") && !seen[$1]++) print $1
        next
      }
      # Linear: issue URLs only, once per issue: a URL with the title slug and
      # the one built from the ID are the same issue.
      only == "linear" {
        if (match($1, /^https:\/\/linear\.app\/[^\/]+\/issue\/[A-Z][A-Z0-9]*-[0-9]+/) &&
          !seen[substr($1, 1, RLENGTH)]++) print
        next
      }
      # Jira: browse URLs only, once per issue.
      only == "jira" {
        if (match($1, /^https:\/\/[^\/]+\.atlassian\.net\/browse\/[A-Z][A-Z0-9_]*-[0-9]+/) &&
          !seen[substr($1, 1, RLENGTH)]++) print
        next
      }
      # Confluence: pages and blog posts, once per page: URLs with and
      # without the title slug are the same page.
      only == "confluence" {
        if (!match($1, /^https:\/\/[^\/]+\.atlassian\.net\/wiki\//)) next
        key = $1
        if (match($1, /^https:\/\/[^\/]+\/wiki\/spaces\/[^\/]+\/(pages|blog\/[0-9\/]+)\/[0-9]+/) ||
          match($1, /^https:\/\/[^\/]+\/wiki\/.*[?&]pageId=[0-9]+/)) key = substr($1, 1, RLENGTH)
        else if ($1 !~ /\/wiki\/x\//) next
        if (!seen[key]++) print
        next
      }
      # GitHub: the repo part of the URL, minus pages that are not repos
      # (github.com/settings/..., github.com/orgs/...).
      !match($1, /^https:\/\/github\.com\/[A-Za-z0-9][A-Za-z0-9-]*\/[A-Za-z0-9._-]+/) { next }
      {
        repo = substr($1, 1, RLENGTH)
        rest = substr($1, RLENGTH + 1)
        sub(/\.git$/, "", repo)
        split(repo, part, "/")
        if (part[4] ~ /^(about|apps|codespaces|collections|enterprise|explore|features|issues|login|marketplace|notifications|organizations|orgs|pricing|pulls|search|security|settings|sponsors|topics|trending|users)$/) next
        # A reference (owner/repo#123) was listed as an issue URL.
        ref = $2 ~ /#[0-9]+$/
      }
      only == "repo" { if (!seen[repo]++) print repo; next }
      {
        if (match(rest, /^\/pull\/[0-9]+/)) n = substr(rest, 7, RLENGTH - 6)
        else if (ref && match(rest, /^\/issues\/[0-9]+/)) n = substr(rest, 9, RLENGTH - 8)
        else next
        url = repo "/pull/" n (only == "checks" ? "/checks" : "")
        if (seen[url]++) next
        if (ref) print url, $2
        else print url
      }
    '
  exit
fi

capture >/dev/null

popup=()
[[ "${target}" == %* ]] && popup=(--tmux 'center,80%')

case "${only}" in
url) prompt='URL(s)> ' ;;
linear) prompt='Linear issue(s)> ' ;;
jira) prompt='Jira issue(s)> ' ;;
confluence) prompt='Confluence page(s)> ' ;;
repo) prompt='Repo(s)> ' ;;
pr) prompt='PR(s)> ' ;;
checks) prompt='PR checks> ' ;;
*) prompt='URL(s)> ' ;;
esac

# With a flag, a list of one opens it straight away. The list loads after fzf
# starts (start:reload), which --select-1 doesn't see, so check on load.
# Without a flag, and with one of the issue and page flags, ENTER views in a
# split and CTRL-B opens the browser.
enter="become:open {+1}"
header='<TAB>: select  <ENTER>: open  <CTRL-/>: preview'
case "${only}" in
"" | linear | jira | confluence)
  enter="become:'$0' --open-split '${target}' {+1}"
  header='<TAB>: select  <ENTER>: view in split  <CTRL-B>: browser  <CTRL-/>: preview'
  ;;
esac

single=()
[[ -n "${only}" ]] &&
  single=(--bind "load:transform:[ \"\$FZF_TOTAL_COUNT\" = 1 ] && echo \"${enter}\" || true")

fzf \
  --bind "start:reload:'$0' ${only:+--${only}} '${target}' --list" \
  --bind "enter:${enter}" \
  --bind "ctrl-b:become:open {+1}" \
  --preview "'$0' --preview {1}" \
  --preview-window 'right,55%,wrap,<100(down,60%,wrap)' \
  --bind 'ctrl-/:toggle-preview' \
  ${single[@]+"${single[@]}"} \
  --delimiter=$'\t' \
  --multi \
  --prompt="${prompt}" \
  --header="${header}" \
  --reverse \
  ${popup[@]+"${popup[@]}"} || true

# vim:sts=2:ts=2:sw=2:et:
