#!/usr/bin/env bash
# Publishes a coding agent's pull request to herdr as display-only pane metadata.
#
# Reads the normalised envelope produced by agent-status on stdin and reports it
# with `herdr pane report-metadata` as custom pane tokens:
#
#   $pr       state glyph and number: " #7"
#   $prstate  "draft", "merged" or "closed"; empty while the PR is open
#   $prci     check rollup glyph, with the jobs behind it while pending or
#             failing: "<clock> 2" running, "<xmark> 3" failed, "<check>" passed
#   $prrev    review glyph: approved, changes requested or review required
#   $prthl    comments glyph, present only beside a count
#   $prth     number of unresolved review threads; empty at zero
#
# rendered by [ui.sidebar.agents.rows_by_agent] in ~/.config/herdr/config.toml,
# which colors $prci and $prrev by matching the glyphs below with `starts_with`
# and `equals` rules.
# A glyph changed here has to change there too. The thread count travels apart
# from its glyph because herdr's `gt` rules only compare values that parse
# completely as numbers.
#
# The glyphs are Nerd Font private-use codepoints, so the terminal font has to be
# a Nerd Font. CI and review are glyph-only because the expanded sidebar is
# 18-36 columns wide and their color already says which way they went.
#
# Deliberately no --display-agent: the reported agent label is what split pane
# borders render, and PR state there is more clutter than signal.
#
# An empty token value clears that key, and a row disappears when every token in
# it is empty, so a pane on a branch with no PR leaves no trace in the sidebar.
#
# Usage:
#   agent-status | herdr-agent-status   publish (not called directly)
#   herdr-agent-status --clear          clear every field this script reports
#
# Outside a herdr pane this is a silent no-op.

set -uo pipefail

# $HERDR_PANE_ID is injected into every herdr-managed pane and inherited by
# grandchildren, so it names the pane to annotate even when the write happens
# from claude's status line command rather than the agent process itself.
[ -n "${HERDR_PANE_ID:-}" ] || exit 0
HERDR_BIN=${HERDR_BIN_PATH:-herdr}
command -v "$HERDR_BIN" >/dev/null 2>&1 || exit 0

pane=$HERDR_PANE_ID
# A pane accepts sequenced token reports from at most 32 distinct sources during
# its lifetime and clearing never releases a slot, so this must stay a single
# constant rather than anything per-session.
SOURCE=dotfiles.agent-status

# Only the pr* tokens are reported. The rest are what earlier versions of this
# script published - model, context, rate limits, token counts - and stay in the
# clear list so a pane annotated by one of them loses those too.
TOKENS=(pr prstate prci prrev prthl prth
    model effort where repo branch ctxl ctx u5hl u5h u5hr u7dl u7d u7dr
    spend cache hit)

# UTF-8 bytes rather than $'\uXXXX', which bash leaves unexpanded outside a UTF-8
# locale - and a status line subprocess is not guaranteed one.
#
# nf-oct-git_pull_request U+F407, _draft U+F4DD, git_merge U+F419,
# git_pull_request_closed U+F4DC
G_OPEN=$'\xef\x90\x87'
G_DRAFT=$'\xef\x93\x9d'
G_MERGED=$'\xef\x90\x99'
G_CLOSED=$'\xef\x93\x9c'
# nf-fa-check U+F00C, nf-fa-xmark U+F00D, nf-fa-clock U+F017
G_PASS=$'\xef\x80\x8c'
G_FAIL=$'\xef\x80\x8d'
G_PENDING=$'\xef\x80\x97'
# nf-fa-thumbs_up U+F164, nf-fa-pen_to_square U+F044, nf-fa-eye U+F06E
G_APPROVED=$'\xef\x85\xa4'
G_CHANGES=$'\xef\x81\x84'
G_REVIEW=$'\xef\x81\xae'
# nf-fa-comments U+F086
G_THREADS=$'\xef\x82\x86'

# Keyed by socket as well as pane id: pane ids restart at w1:p1 when the server
# does, and a stale cache entry would otherwise suppress a new pane's first
# publish.
cache_dir="${TMPDIR:-/tmp}/herdr-agent-status"
cache_key=$(printf '%s' "${HERDR_SOCKET_PATH:-default}|$pane" | tr -c '[:alnum:]._-' '-')
cache_file="$cache_dir/$cache_key"

# Publishes are backgrounded by their producers and can overlap, so every report
# is sequenced and herdr drops any that arrives out of order. Time::HiRes keeps
# the sequence monotonic at sub-second resolution; the fallback loses ordering
# within a second, which is the same resolution as no sequencing at all. A run
# that sends several reports numbers them up from this base.
next_seq() {
    perl -MTime::HiRes=time -e 'printf "%.0f", time * 1000' 2>/dev/null \
        || printf '%s' "$(($(date '+%s') * 1000))"
}
seq=$(next_seq)

# herdr rejects a whole report that updates more than 16 tokens ("a metadata
# report may update at most 16 tokens"), and TOKENS is longer than that, so
# clears go out in batches. 15 rather than 16 leaves room for
# --clear-display-agent, in case herdr counts it against the same limit.
#
# --clear-display-agent covers panes still carrying a label from before this
# script stopped reporting one.
clear_tokens() {
    local args=() name
    for name in "$@"; do
        args+=(--clear-token "$name")
        if [ ${#args[@]} -ge 30 ]; then
            "$HERDR_BIN" pane report-metadata "$pane" --source "$SOURCE" \
                --seq "$seq" --clear-display-agent "${args[@]}" >/dev/null 2>&1 \
                || return 1
            seq=$((seq + 1))
            args=()
        fi
    done
    [ ${#args[@]} -gt 0 ] || return 0
    "$HERDR_BIN" pane report-metadata "$pane" --source "$SOURCE" \
        --seq "$seq" --clear-display-agent "${args[@]}" >/dev/null 2>&1 || return 1
    seq=$((seq + 1))
}

clear_pane() {
    # Remove the cache entry first: on a shutdown path the agent may not outlive
    # this process long enough for the socket round-trip to finish.
    rm -f "$cache_file" 2>/dev/null
    clear_tokens "${TOKENS[@]}"
    exit 0
}

[ "${1:-}" = "--clear" ] && clear_pane

command -v jq >/dev/null 2>&1 || exit 0

input=$(cat)
[ -n "$input" ] || exit 0

# `-` stands in for absent rather than an empty field: tab is an IFS whitespace
# character, so `read` collapses runs of it and empty fields would desynchronise
# the whole line.
fields=$(printf '%s' "$input" | jq -r '
    def f: if . == null or . == "" then "-" else tostring end;
    [ (.agent | f)
    , (.pr | f)
    , (.pr_state | f)
    , (.pr_ci | f)
    , (.pr_ci_count | f)
    , (.pr_review | f)
    , (.pr_threads | f)
    ] | @tsv' 2>/dev/null)
[ -n "$fields" ] || exit 0

IFS=$'\t' read -r agent pr state ci ci_count review threads <<<"$fields"

for var in agent pr state ci ci_count review threads; do
    [ "${!var}" = "-" ] && declare "$var="
done

[ -n "$agent" ] || exit 0

if [ -n "$pr" ]; then
    case $state in
        draft) pr="$G_DRAFT $pr" ;;
        merged) pr="$G_MERGED $pr" ;;
        closed) pr="$G_CLOSED $pr" ;;
        *) pr="$G_OPEN $pr" ;;
    esac
fi

case $ci in
    pass) ci=$G_PASS ;;
    fail) ci=$G_FAIL ;;
    pending) ci=$G_PENDING ;;
    *) ci="" ;;
esac
# The count shares the glyph's token, so herdr draws "<clock> 2" rather than
# putting its separator dot between them; the rules color by the leading glyph.
case $ci_count in
    '' | *[!0-9]*) ;;
    *) [ -n "$ci" ] && ci="$ci $ci_count" ;;
esac

case $review in
    approved) review=$G_APPROVED ;;
    changes) review=$G_CHANGES ;;
    review) review=$G_REVIEW ;;
    *) review="" ;;
esac

case $threads in
    '' | 0 | *[!0-9]*) threads="" ;;
esac

# Once a PR is merged or closed, its checks and reviews are history rather than
# something to act on.
case $state in
    merged | closed)
        ci=""
        review=""
        threads=""
        ;;
esac

# The glyph is cleared with the count, so a PR with every thread resolved shows
# no bare comments icon.
threads_label=""
[ -n "$threads" ] && threads_label=$G_THREADS

# Producers fire far more often than the metadata changes (claude's status line
# re-renders on every event), so skip the socket round-trip when nothing moved.
payload="$pr|$state|$ci|$review|$threads"
if [ -r "$cache_file" ] && [ "$(cat "$cache_file" 2>/dev/null)" = "$payload" ]; then
    exit 0
fi

# The first publish from this pane also clears what an older version of this
# script left behind, which the pr* tokens alone would not overwrite. It goes
# first, in reports of its own, so the PR report after it stays under herdr's
# token limit; if it fails, so does this publish, and the next one retries.
if [ ! -e "$cache_file" ]; then
    clear_tokens "${TOKENS[@]:6}" || exit 0
fi

args=(pane report-metadata "$pane"
    --source "$SOURCE"
    --seq "$seq"
    --token "pr=$pr"
    --token "prstate=$state"
    --token "prci=$ci"
    --token "prrev=$review"
    --token "prthl=$threads_label"
    --token "prth=$threads")

"$HERDR_BIN" "${args[@]}" >/dev/null 2>&1 \
    && { mkdir -p "$cache_dir" 2>/dev/null && printf '%s' "$payload" >"$cache_file" 2>/dev/null; }

exit 0
