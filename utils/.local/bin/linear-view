#!/usr/bin/env bash
# linear-view -- show a Linear issue from a Rex block's or tmux pane's
# scrollback in the terminal, with `linear issue view`.
#
# Usage: linear-view [PANE|BLOCK]
#
# The issues are the ones fzf-urls --linear finds (issue URLs, and IDs of
# known team keys), newest first. With one, it's shown straight away; with
# several, fzf picks one, previewing each. With none, the current branch's
# issue is shown, as `linear issue view` finds it from the branch name.
#
# Dependencies: the linear CLI, logged in; fzf; bat (for the preview)

set -euo pipefail
[[ "${DEBUG:-}" == "true" ]] && set -x

ids=()
while read -r id; do
  ids+=("${id}")
done < <(fzf-urls --linear "${1:-}" --list |
  sed -nE 's|^https://linear\.app/[^/]+/issue/([A-Z][A-Z0-9]*-[0-9]+).*|\1|p' |
  awk '!seen[$0]++')

case ${#ids[@]} in
0) exec linear issue view ;;
1) exec linear issue view "${ids[0]}" ;;
esac

id="$(printf '%s\n' "${ids[@]}" |
  fzf \
    --prompt='Linear issue> ' \
    --header='<ENTER>: view' \
    --reverse \
    --preview='linear issue view --no-pager --no-comments {} | bat -pl md --color=always' \
    --preview-window='right,60%,wrap')" || exit 0
exec linear issue view "${id}"

# vim:sts=2:ts=2:sw=2:et:
