#!/usr/bin/env bash
#
# git pb [-R OWNER/REPO] [<pr>]
#
# PR blockers: what still stands between a pull request and merging — its
# failing CI checks (git failing-checks) and its unresolved review threads
# (git unresolved), one section each.
#
# <pr> is as for those two: omitted for the current branch's PR, 123, #123,
# OWNER/REPO#123, or a PR URL. It is resolved once here, so both halves report
# on the same PR. For their other flags (--json, --all, -n), run them directly.
#
# Note: `git pb --help` is hijacked by git's man lookup — use -h.

set -euo pipefail
[[ "${DEBUG:-}" == "true" ]] && set -x

pr=""
repo=""

while [ $# -gt 0 ]; do
  case "$1" in
    -R | --repo) repo="${2:?--repo needs OWNER/REPO}"; shift 2 ;;
    -h | --help) sed -n "2,13p" "$0" | cut -c 3-; exit 0 ;;
    --) shift; break ;;
    -*) echo "git pb: unknown flag: $1" >&2; exit 2 ;;
    *) pr="$1"; shift ;;
  esac
done
[ -n "${1:-}" ] && pr="$1"

here="${BASH_SOURCE[0]%/*}"
# shellcheck source=git-pr-arg.sh disable=SC1091
source "$here/git-pr-arg.sh"
pr_arg_resolve "git pb"

args=(${repo:+--repo "$repo"} "$pr")

# Both halves run to completion even if one fails, so a broken checks lookup
# still shows the threads; the exit status is the first failure.
status=0
echo "== Failing checks"
"$here/git-failing-checks" "${args[@]}" || status=$?
echo
echo "== Unresolved review threads"
"$here/git-unresolved" "${args[@]}" || { rc=$?; [ "$status" -eq 0 ] && status=$rc; }
exit "$status"
