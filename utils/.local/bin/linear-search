#!/usr/bin/env bash
# linear-search -- search Linear issues for text with fzf, as you type, and
# send the ones you pick to fai, which picks a directory and starts an agent
# there with the issue's URL typed into its prompt.
#
# Usage: linear-search [text]
#
# Each change to the query runs Linear's full-text search (titles,
# descriptions and comments) across the workspace, archived issues excluded,
# best match first, as ID, team, status, assignee and title. The query needs
# at least 2 characters. A preview shows the issue.
#
# TAB marks several issues. ENTER runs fai once per issue, in turn, so each can
# go to its own directory and agent; ESC in fai skips that issue. CTRL-V views
# an issue in full, paged; CTRL-O opens it in the browser; CTRL-Y copies its
# URL. ESC quits.
#
# Dependencies: the linear CLI, logged in; fzf; jq; bat (for the preview); fai

set -euo pipefail
[[ "${DEBUG:-}" == "true" ]] && set -x

self="$(realpath "${BASH_SOURCE[0]}")"
limit="${LINEAR_SEARCH_LIMIT:-100}"

# search <text>: print the issues matching <text> for fzf: URL, ID, then the
# line shown; or a message when there are none, or the search failed
search() {
  local term="${1:-}" out
  if ((${#term} < 2)); then
    echo "Type at least 2 characters to search"
    return 0
  fi
  # wait out fast typing: fzf kills this run when the query changes again
  sleep 0.3
  # JSON variables, so a term like 123, true or @file stays a string
  # shellcheck disable=SC2016 # GraphQL variables, not shell ones
  if ! out="$(linear api --variables-json "$(jq -cn \
    --arg term "${term}" --argjson first "${limit}" \
    '{term: $term, first: $first}')" '
    query($term: String!, $first: Int) {
      searchIssues(term: $term, first: $first) {
        nodes {
          url identifier title
          team { key }
          state { name }
          assignee { displayName }
        }
      }
    }' 2>&1 | jq -r '.data.searchIssues.nodes[]
      | [.url, .identifier, .team.key, .state.name,
         (.assignee.displayName // "Unassigned"),
         (.title | gsub("[\t\n\r]"; " "))]
      | @tsv' 2>&1)"; then
    echo "Search failed: ${out%%$'\n'*}"
    return 0
  fi
  if [[ -z "${out}" ]]; then
    echo "No issues match"
    return 0
  fi
  awk -F'\t' -v OFS='\t' '{
    print $1, $2, sprintf("%-10s %-5s %-14.14s %-18.18s %s", $2, $3, $4, $5, $6)
  }' <<<"${out}"
}

# open_url <url>: open a URL in the browser
open_url() {
  if command -v open >/dev/null; then open "${1}"; else xdg-open "${1}"; fi
}

# copy_url <url>: copy a URL to the clipboard
copy_url() {
  if command -v pbcopy >/dev/null; then
    printf '%s' "${1}" | pbcopy
  else
    printf '%s' "${1}" | wl-copy
  fi
}

main() {
  local q urls url
  q="$(printf '%q' "${self}")"
  # Message lines have no URL, so the bindings skip them ({1} is empty).
  urls="$(search "${1:-}" | fzf \
    --multi \
    --disabled \
    --query="${1:-}" \
    --delimiter='\t' \
    --with-nth=3 \
    --prompt='Search Linear> ' \
    --header='ENTER: send to fai / TAB: mark / CTRL-V: view / CTRL-O: browser / CTRL-Y: copy URL' \
    --reverse \
    --preview='[[ -n {2} ]] && linear issue view --no-pager --no-comments {2} | bat -pl md --color=always' \
    --preview-window='right,50%,wrap,<120(down,50%,wrap)' \
    --bind="change:reload(${q} --search {q})" \
    --bind="ctrl-v:execute([[ -n {2} ]] && linear issue view {2} | bat -l md --paging=always --style=plain --color=always)" \
    --bind="ctrl-o:execute-silent([[ -n {1} ]] && ${q} --open {1})" \
    --bind="ctrl-y:execute-silent([[ -n {1} ]] && ${q} --copy {1})" |
    awk -F'\t' 'NF >= 3 { print $1 }')" || exit 0

  while read -r url; do
    [[ -n "${url}" ]] || continue
    # fai reads the terminal, not the list
    fai "${url}" </dev/tty || true
  done <<<"${urls}"
}

case "${1:-}" in
--search) search "${2:-}" ;;
--open) open_url "${2:?url}" ;;
--copy) copy_url "${2:?url}" ;;
-*)
  echo "Usage: linear-search [text]" >&2
  exit 2
  ;;
*) main "${1:-}" ;;
esac

# vim:sts=2:ts=2:sw=2:et:
