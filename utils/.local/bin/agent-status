#!/usr/bin/env bash
# Looks up the pull request for a coding agent's branch and hands it to the
# herdr sidebar, so a pane whose PR is waiting on CI or review says so beside
# the agent instead of only inside it.
#
# Producers (claude's status line, pi's agent-pane-status extension) pipe one
# JSON envelope on stdin naming the agent and where it is working:
#
#   {"agent":"claude","cwd":"/path"}
#
# This script resolves the repo, branch and PR exactly once and hands the sink a
# normalised envelope, where an absent value is the empty string:
#
#   {"agent":"claude","repo":"dotfiles","branch":"herdr-pr-status",
#    "pr":"#7","pr_state":"","pr_ci":"pending","pr_review":"review",
#    "pr_threads":"3"}
#
#   pr         "#<number>" of the open, draft, merged or closed PR for the branch
#   pr_state   "draft", "merged" or "closed"; empty for an open PR, which is
#              the case worth the least ink
#   pr_ci      "pass", "fail" or "pending" across every check; empty when the
#              PR has none
#   pr_review  "approved", "changes" or "review" (review required); empty when
#              the repo asks for no review decision
#   pr_threads count of unresolved review threads; empty when there are none
#
# The values are bare words rather than glyphs so the sink decides how they are
# drawn and herdr's text rules can match them.
#
# Producers fire far more often than a PR changes - claude's status line runs on
# every event - and `gh` is a network round-trip, so lookups are cached per
# repo and branch for PR_TTL seconds. An expired entry is touched before the
# lookup starts, so the concurrent publishes a burst of events produces reuse
# the old answer instead of each starting their own `gh`.
#
# The default branch is never looked up: it has no PR of its own, and it is
# where most idle panes sit.
#
# Usage:
#   <producer> | agent-status     publish
#   agent-status --clear          clear this pane's PR metadata
#
# Outside a herdr pane this is a silent no-op, so agents run unaffected.

set -uo pipefail

SINK=${HOME}/.local/bin/herdr-agent-status

# $HERDR_PANE_ID is inherited from the agent process, which is the right pane
# even when the write happens from a grandchild (claude's status line command).
[ -n "${HERDR_PANE_ID:-}" ] || exit 0
[ -x "$SINK" ] || exit 0

if [ "${1:-}" = "--clear" ]; then
    "$SINK" --clear >/dev/null 2>&1
    exit 0
fi

command -v jq >/dev/null 2>&1 || exit 0

# An open PR moves on the scale of CI runs and reviews; a merged or closed one
# only changes if it is reopened.
PR_TTL=${AGENT_STATUS_PR_TTL:-60}
PR_TTL_SETTLED=600

input=$(cat)
[ -n "$input" ] || exit 0

agent=$(printf '%s' "$input" | jq -r '.agent // empty' 2>/dev/null)
cwd=$(printf '%s' "$input" | jq -r '.cwd // empty' 2>/dev/null)
[ -n "$agent" ] || exit 0

repo=""
branch=""
root=""
if [ -n "$cwd" ] && [ -d "$cwd" ]; then
    root=$(git -C "$cwd" --no-optional-locks rev-parse --show-toplevel 2>/dev/null)
    if [ -n "$root" ]; then
        repo=$(basename "$root")
        # Empty on a detached HEAD, which has no PR to find.
        branch=$(git -C "$cwd" --no-optional-locks branch --show-current 2>/dev/null)
    fi
fi

default_branch() {
    local ref
    ref=$(git -C "$root" --no-optional-locks symbolic-ref --quiet --short \
        refs/remotes/origin/HEAD 2>/dev/null) && {
        printf '%s' "${ref#origin/}"
        return
    }
    printf 'main'
}

# Seconds since a file was last modified; perl because stat's flags differ
# between macOS and Linux.
age() {
    perl -e 'my @s = stat shift or exit 1; print time - $s[9]' "$1" 2>/dev/null
}

# Prints the PR as one compact JSON object, or "{}" when the branch has none.
#
# One GraphQL query rather than `gh pr view`, because review threads are only
# exposed there; {owner} and {repo} are filled in by gh from the checkout's
# remote. With several PRs from one branch, the newest wins.
#
# The CI state is GitHub's own rollup across every check run and commit status,
# under which a check that did not run (skipped, neutral) counts as passing.
#
# Threads count as unaddressed while unresolved, outdated or not: a reply that
# leaves the thread open has not closed it. Only the first 100 are read.
lookup_pr() {
    local json
    # shellcheck disable=SC2016 # $owner etc. are GraphQL variables, not shell
    json=$(cd "$root" && gh api graphql \
        -F owner='{owner}' -F repo='{repo}' -f branch="$branch" -f query='
        query($owner: String!, $repo: String!, $branch: String!) {
          repository(owner: $owner, name: $repo) {
            pullRequests(headRefName: $branch, first: 1,
                         orderBy: {field: CREATED_AT, direction: DESC}) {
              nodes {
                number state isDraft reviewDecision
                commits(last: 1) { nodes { commit { statusCheckRollup { state } } } }
                reviewThreads(first: 100) { nodes { isResolved } }
              }
            }
          }
        }' 2>/dev/null) || {
        # gh exits 1 on a network failure and on GraphQL errors alike,
        # including rate limits, and this reports that as "no PR": the row
        # vanishes until the next lookup succeeds, and the "{}" overwrites a
        # good cached answer. A possible improvement is to keep the cached
        # answer on failure, publish it marked as stale (dimmed, or with a
        # warning glyph), and retry sooner than PR_TTL.
        printf '{}'
        return
    }
    printf '%s' "$json" | jq -c '
        .data.repository.pullRequests.nodes[0]
        | if . == null then {} else
          { pr: "#\(.number)",
            pr_state: (if .state == "MERGED" then "merged"
                       elif .state == "CLOSED" then "closed"
                       elif .isDraft then "draft"
                       else "" end),
            pr_ci: ({ SUCCESS: "pass", FAILURE: "fail", ERROR: "fail",
                      PENDING: "pending", EXPECTED: "pending" }
                    [.commits.nodes[0].commit.statusCheckRollup.state // ""] // ""),
            pr_review: ({ APPROVED: "approved",
                          CHANGES_REQUESTED: "changes",
                          REVIEW_REQUIRED: "review" }[.reviewDecision // ""] // ""),
            pr_threads: ([ .reviewThreads.nodes[] | select(.isResolved | not) ]
                         | length)
          } end' 2>/dev/null || printf '{}'
}

pr_json='{}'
if [ -n "$branch" ] && [ "$branch" != "$(default_branch)" ] \
    && command -v gh >/dev/null 2>&1; then
    cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/agent-status/pr"
    cache_key=$(printf '%s' "$root|$branch" | tr -c '[:alnum:]._-' '-')
    cache_file="$cache_dir/$cache_key"

    ttl=$PR_TTL
    if [ -r "$cache_file" ]; then
        pr_json=$(cat "$cache_file" 2>/dev/null)
        case $(printf '%s' "$pr_json" | jq -r '.pr_state // empty' 2>/dev/null) in
            merged | closed) ttl=$PR_TTL_SETTLED ;;
        esac
    fi

    elapsed=$(age "$cache_file") || elapsed=""
    if [ -z "$elapsed" ] || [ "$elapsed" -ge "$ttl" ]; then
        mkdir -p "$cache_dir" 2>/dev/null
        touch "$cache_file" 2>/dev/null
        pr_json=$(lookup_pr)
        printf '%s' "$pr_json" >"$cache_file" 2>/dev/null
    fi
    [ -n "$pr_json" ] || pr_json='{}'
fi

normalised=$(printf '%s' "$pr_json" | jq -c \
    --arg agent "$agent" \
    --arg repo "$repo" \
    --arg branch "$branch" \
    '{ $agent, $repo, $branch,
       pr: (.pr // ""), pr_state: (.pr_state // ""),
       pr_ci: (.pr_ci // ""), pr_review: (.pr_review // ""),
       pr_threads: ((.pr_threads // 0) | if . > 0 then tostring else "" end) }' 2>/dev/null)
[ -n "$normalised" ] || exit 0

printf '%s' "$normalised" | "$SINK" >/dev/null 2>&1

exit 0
