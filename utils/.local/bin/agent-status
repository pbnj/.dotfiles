#!/usr/bin/env bash
# Shows the pull request for a coding agent's branch in the herdr sidebar, so a
# pane whose PR is waiting on CI or review says so beside the agent instead of
# only inside it.
#
# Producers (claude's status line, pi's agent-pane-status extension) pipe one
# JSON envelope on stdin naming the agent and where it is working:
#
#   {"agent":"claude","cwd":"/path"}
#
# This script makes no GitHub calls. The PR comes from the snapshot gh-pr-watch
# (the gh skill's PR watch, in komodohealth/Security-Automation) keeps while it
# watches an open PR, and deletes once the PR merges or closes:
#
#   ${XDG_CACHE_HOME:-~/.cache}/gh-pr/<owner>/<name>/<branch>.json
#
# with the branch percent-encoded as jq's @uri does. So a branch shows a PR only while some agent is watching it. A snapshot whose
# watch stopped updating it more than AGENT_STATUS_PR_MAX_AGE seconds ago
# (default 900) is ignored, since a watch that died before the merge never
# deletes it.
#
# This script resolves the repo and branch exactly once and hands the sink a
# normalised envelope, where an absent value is the empty string:
#
#   {"agent":"claude","repo":"dotfiles","branch":"herdr-pr-status",
#    "pr":"#7","pr_state":"","pr_ci":"pending","pr_ci_count":"2","pr_review":"review",
#    "pr_threads":"3"}
#
#   pr         "#<number>" of the branch's open or draft PR
#   pr_state   "draft"; empty for an open PR, which is the case worth the
#              least ink
#   pr_ci_count  jobs behind pr_ci: still running for "pending", failed for
#              "fail"; empty for "pass", where skipped jobs would make a total
#              misleading
#   pr_ci      "pass", "fail" or "pending" across every check; empty when the
#              PR has none
#   pr_review  "approved", "changes" or "review" (review required); empty when
#              the repo asks for no review decision
#   pr_threads count of unresolved review threads; empty when there are none
#
# The values are bare words rather than glyphs so the sink decides how they are
# drawn and herdr's text rules can match them.
#
# It also records which repo and branch each pane is on, for readers that join
# panes to the gh-pr snapshots themselves (the herdr-bridge native messaging
# host behind the browser extension):
#
#   $XDG_CACHE_HOME/agent-status/panes/<socket>--<pane>.json
#
#   {"v":2,"socket":"...","pane":"w1:p1","agent":"claude","cwd":"...",
#    "root":"...","repo":"dotfiles","slug":"pbnj/dotfiles","branch":"..."}
#
# where <socket>--<pane> is "$HERDR_SOCKET_PATH|$HERDR_PANE_ID" with every
# character outside [A-Za-z0-9._-] replaced by "-". It is keyed by socket as
# well as pane because pane ids restart at w1:p1 with the server. The record is
# replaced atomically and only rewritten when it changes, so a reader can watch
# the directory without being woken by every status line render.
#
# Usage:
#   <producer> | agent-status     publish
#   agent-status --clear          clear this pane's PR metadata
#
# Outside a herdr pane this is a silent no-op, so agents run unaffected.

set -uo pipefail

SINK=${HOME}/.local/bin/herdr-agent-status

# $HERDR_PANE_ID is inherited from the agent process, which is the right pane
# even when the write happens from a grandchild (claude's status line command).
[ -n "${HERDR_PANE_ID:-}" ] || exit 0
[ -x "$SINK" ] || exit 0

cache_home="${XDG_CACHE_HOME:-$HOME/.cache}"
socket=${HERDR_SOCKET_PATH:-default}
pane_key=$(printf '%s' "$socket|$HERDR_PANE_ID" | tr -c '[:alnum:]._-' '-')
pane_dir="$cache_home/agent-status/panes"
pane_file="$pane_dir/$pane_key.json"

if [ "${1:-}" = "--clear" ]; then
    rm -f "$pane_file" 2>/dev/null
    "$SINK" --clear >/dev/null 2>&1
    exit 0
fi

command -v jq >/dev/null 2>&1 || exit 0

PR_MAX_AGE=${AGENT_STATUS_PR_MAX_AGE:-900}

input=$(cat)
[ -n "$input" ] || exit 0

agent=$(printf '%s' "$input" | jq -r '.agent // empty' 2>/dev/null)
cwd=$(printf '%s' "$input" | jq -r '.cwd // empty' 2>/dev/null)
[ -n "$agent" ] || exit 0

repo=""
slug=""
branch=""
root=""
if [ -n "$cwd" ] && [ -d "$cwd" ]; then
    root=$(git -C "$cwd" --no-optional-locks rev-parse --show-toplevel 2>/dev/null)
    if [ -n "$root" ]; then
        repo=$(basename "$root")
        # Empty on a detached HEAD, which has no PR to find.
        branch=$(git -C "$cwd" --no-optional-locks branch --show-current 2>/dev/null)
        # owner/name from origin's last two path segments, which is how the
        # gh-pr snapshots are filed. Not anchored on github.com: an SSH host
        # alias such as "personal:pbnj/.dotfiles" names no host at all.
        slug=$(git -C "$cwd" --no-optional-locks remote get-url origin 2>/dev/null \
            | sed -E 's#\.git$##; s#/+$##' | sed -nE 's#^.*[:/]([^/:]+/[^/:]+)$#\1#p')
    fi
fi

# The branch's snapshot, or "{}" when there is none or it has gone stale. Its own
# repo and branch fields have to match too, as a guard against a slug parsed
# from an unusual remote.
pr_json='{}'
if [ -n "$slug" ] && [ -n "$branch" ]; then
    snapshot="$cache_home/gh-pr/$slug/$(jq -rn --arg b "$branch" '$b | @uri').json"
    if [ -r "$snapshot" ]; then
        pr_json=$(jq -c --arg slug "$slug" --arg branch "$branch" \
            --argjson max_age "$PR_MAX_AGE" '
            if .repo == $slug and .branch == $branch
               and (now - (.fetched_at // 0)) <= $max_age
            then . else {} end' "$snapshot" 2>/dev/null) || pr_json='{}'
        [ -n "$pr_json" ] || pr_json='{}'
    fi
fi

# Rewritten only when it changes, and swapped in with a rename so a reader never
# sees a half-written record.
write_pane_record() {
    local record tmp
    record=$(jq -nc \
        --arg socket "$socket" --arg pane "$HERDR_PANE_ID" \
        --arg agent "$agent" --arg cwd "$cwd" --arg root "$root" \
        --arg repo "$repo" --arg slug "$slug" --arg branch "$branch" \
        '{ v: 2, $socket, $pane, $agent, $cwd, $root, $repo, $slug, $branch }' 2>/dev/null) || return
    [ -n "$record" ] || return
    if [ -r "$pane_file" ] && [ "$(cat "$pane_file" 2>/dev/null)" = "$record" ]; then
        return
    fi
    mkdir -p "$pane_dir" 2>/dev/null || return
    tmp=$(mktemp "$pane_dir/.record.XXXXXX" 2>/dev/null) || return
    if ! { printf '%s\n' "$record" >"$tmp" && mv -f "$tmp" "$pane_file"; } 2>/dev/null; then
        rm -f "$tmp" 2>/dev/null
    fi
}
write_pane_record

normalised=$(printf '%s' "$pr_json" | jq -c \
    --arg agent "$agent" \
    --arg repo "$repo" \
    --arg branch "$branch" \
    '{ $agent, $repo, $branch,
       pr: (if .number then "#\(.number)" else "" end),
       pr_state: (if .state == "draft" then "draft" else "" end),
       pr_ci: (.ci // ""), pr_review: (.review // ""),
       pr_ci_count: ((.ci_counts[.ci // ""]? // 0)
                     | if . > 0 then tostring else "" end),
       pr_threads: ((.threads // []) | length | if . > 0 then tostring else "" end) }' 2>/dev/null)
[ -n "$normalised" ] || exit 0

printf '%s' "$normalised" | "$SINK" >/dev/null 2>&1

exit 0
