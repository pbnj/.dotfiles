#!/usr/bin/env bash
# Normalises coding-agent metadata and fans it out to every live pane-decoration
# transport, so one producer feeds both tmux pane borders and the herdr sidebar.
#
# Producers (claude's status line, pi's agent-pane-status extension) pipe one
# JSON envelope on stdin:
#
#   {"agent":"claude","model":"Opus 5","effort":"medium","cwd":"/path","ctx_pct":42,
#    "limit_5h":8,"reset_5h":"2h 55m","limit_7d":17,"reset_7d":"79h 15m"}
#   {"agent":"pi","model":"gpt-5.6-luna","effort":"max","cwd":"/path","ctx_pct":1,
#    "input":163,"output":71828,"cache_read":11846398,"cache_write":197812}
#
# A producer fills whichever usage fields it has: claude reports rate limits,
# which is what actually constrains the next hour of work, while pi has none and
# reports session token totals instead. Each sink picks by which arrived.
#
# The token fields are session totals, not per-turn values: ctx_pct already
# covers the live context, so the counts are only worth the space if they say
# what the session as a whole has spent.
#
# Every field except `agent` is optional. This script resolves the display form
# of each one exactly once and hands the sinks a normalised envelope, where an
# absent value is the empty string:
#
#   {"agent":"claude","model":"opus-5","effort":"med","effort_long":"medium","repo":"dotfiles",
#    "branch":"main","ctx":"42%","ctx_pct":42,"tokens":"i:163 | o:71.8k",
#    "limit_5h":"8%","reset_5h":"2h55m","limit_7d":"17%","reset_7d":"79h15m"}
#
# Sinks own only their transport: tmux-agent-status writes @agent_* pane options
# read by pane-border-format, herdr-agent-status reports pane metadata read by
# the herdr sidebar and pane borders. Both may run at once, which is what happens
# when herdr is launched inside tmux.
#
# Usage:
#   <producer> | agent-status     publish
#   agent-status --clear          clear this pane's decoration on every transport
#
# With no live transport this is a silent no-op, so agents run unaffected.

set -uo pipefail

BIN_DIR=${HOME}/.local/bin

# A transport is live only when this process can identify the pane to annotate.
# Both variables are inherited from the agent process, which is the right pane
# even when the write happens from a grandchild (claude's status line command).
sinks=()
if [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ]; then
    sinks+=("$BIN_DIR/tmux-agent-status")
fi
if [ -n "${HERDR_PANE_ID:-}" ]; then
    sinks+=("$BIN_DIR/herdr-agent-status")
fi
[ ${#sinks[@]} -gt 0 ] || exit 0

publish() {
    local sink
    for sink in "${sinks[@]}"; do
        [ -x "$sink" ] || continue
        printf '%s' "$1" | "$sink" >/dev/null 2>&1
    done
}

if [ "${1:-}" = "--clear" ]; then
    for sink in "${sinks[@]}"; do
        [ -x "$sink" ] || continue
        "$sink" --clear >/dev/null 2>&1
    done
    exit 0
fi

command -v jq >/dev/null 2>&1 || exit 0

input=$(cat)
[ -n "$input" ] || exit 0

# One jq pass emits every field on a single tab-separated line, with `-`
# standing in for absent so the read below never desynchronises.
fields=$(printf '%s' "$input" | jq -r '
    def f: if . == null or . == "" then "-" else tostring end;
    [ (.agent | f)
    , (.model | f)
    , (.effort | f)
    , (.cwd | f)
    , (.ctx_pct | f)
    , (.input | f)
    , (.output | f)
    , (.cache_read | f)
    , (.cache_write | f)
    , (.limit_5h | f)
    , (.reset_5h | f)
    , (.limit_7d | f)
    , (.reset_7d | f)
    ] | @tsv' 2>/dev/null)

IFS=$'\t' read -r agent model effort cwd ctx_pct tok_in tok_out tok_cr tok_cw \
    lim_5h rst_5h lim_7d rst_7d <<<"$fields"

[ "${agent:--}" = "-" ] && exit 0

# "Opus 5" -> "opus-5"; "github-copilot/gpt-5.6-luna" -> "gpt-5.6-luna".
short_model() {
    local m=${1##*/}
    m=${m// /-}
    printf '%s' "$m" | tr '[:upper:]' '[:lower:]'
}

# Keep effort to three columns so the medium tier stays inside a split pane.
short_effort() {
    case $1 in
        low) printf 'low' ;;
        medium) printf 'med' ;;
        high) printf 'high' ;;
        xhigh) printf 'xhi' ;;
        max) printf 'max' ;;
        off | none | minimal) printf '%s' "${1:0:3}" ;;
        *) printf '%s' "$1" ;;
    esac
}

# 8500 -> 8.5k, 1569383 -> 1.6M. Sub-1k counts stay exact.
human() {
    local n=$1
    case $n in
        '' | *[!0-9]*) return 1 ;;
    esac
    if [ "$n" -ge 1000000 ]; then
        awk -v n="$n" 'BEGIN{printf "%.1fM", n/1000000}'
    elif [ "$n" -ge 1000 ]; then
        awk -v n="$n" 'BEGIN{printf "%.1fk", n/1000}'
    else
        printf '%s' "$n"
    fi
}

as_pct() {
    [ "$1" = "-" ] && return 0
    awk -v p="$1" 'BEGIN{printf "%.0f%%", p}' 2>/dev/null
}

# Same derivation as ~/.config/tmux/scripts/git-cwd.sh: repo root basename plus
# the branch, falling back to a short SHA on a detached HEAD.
repo=""
branch=""
if [ "$cwd" != "-" ] && [ -d "$cwd" ]; then
    root=$(git -C "$cwd" --no-optional-locks rev-parse --show-toplevel 2>/dev/null)
    if [ -n "$root" ]; then
        repo=$(basename "$root")
        branch=$(git -C "$cwd" --no-optional-locks branch --show-current 2>/dev/null)
        [ -n "$branch" ] || branch=$(git -C "$cwd" --no-optional-locks rev-parse --short HEAD 2>/dev/null)
    else
        repo=$(basename "$cwd")
    fi
fi

if [ "$model" = "-" ]; then model=""; else model=$(short_model "$model"); fi
# Both forms travel: a tmux border is three columns tighter than a sidebar row,
# so each sink picks the one that fits rather than re-deriving the other.
if [ "$effort" = "-" ]; then
    effort=""
    effort_long=""
else
    effort_long=$(printf '%s' "$effort" | tr '[:upper:]' '[:lower:]')
    effort=$(short_effort "$effort")
fi

ctx=$(as_pct "$ctx_pct")
# Rate limits are Claude.ai Pro/Max only, and only after the first API response;
# the reset countdowns arrive pre-rendered ("2h 55m") from the producer, which
# already formats them for its own status line. Spaces are stripped here because
# every sink renders them bare, next to a label that already says which clock the
# parenthetical belongs to.
limit_5h=$(as_pct "$lim_5h")
limit_7d=$(as_pct "$lim_7d")
[ "$rst_5h" = "-" ] && rst_5h=""
[ "$rst_7d" = "-" ] && rst_7d=""
rst_5h=${rst_5h// /}
rst_7d=${rst_7d// /}
[ "$ctx_pct" = "-" ] && ctx_pct=""

# Session-cumulative tokens as in / out / cache read / cache write, pipe-joined
# to match the tmux border's other separators. Split into spend and cache so a
# sink too narrow for both can render them on separate lines.
#
# Labels are plain ASCII rather than arrows and symbols: the glyphs that fit this
# job semantically (up/down arrows, and the rotation arrows for cache) are
# East-Asian Ambiguous width, so a terminal advances one cell while the font
# draws nearly two and the glyph bleeds into the digits beside it.
#
# A session that has not made an API call yet reports zeroes rather than absent
# fields; "i:0 | o:0 | r:0 | w:0" takes up the border while saying nothing, so
# the whole group is dropped until something has actually been spent.
spend=""
cache=""
any_spend=0
for value in "$tok_in" "$tok_out" "$tok_cr" "$tok_cw"; do
    case $value in
        '' | '-' | *[!0-9]*) continue ;;
    esac
    [ "$value" -gt 0 ] && any_spend=1
done
if [ "$any_spend" = 1 ]; then
    for pair in "spend:i:$tok_in" "spend:o:$tok_out" "cache:r:$tok_cr" "cache:w:$tok_cw"; do
        group=${pair%%:*}
        rest=${pair#*:}
        label=${rest%%:*}
        value=${rest#*:}
        [ "$value" = "-" ] && continue
        formatted=$(human "$value") || continue
        if [ "$group" = spend ]; then
            spend="${spend:+$spend | }$label:$formatted"
        else
            cache="${cache:+$cache | }$label:$formatted"
        fi
    done
fi

# `tokens` is the combined form the tmux border has always rendered; sinks with
# room for only one line keep using it, narrower ones use spend and cache.
tokens="$spend"
[ -n "$cache" ] && tokens="${tokens:+$tokens | }$cache"

normalised=$(jq -n \
    --arg agent "$agent" \
    --arg model "$model" \
    --arg effort "$effort" \
    --arg effort_long "$effort_long" \
    --arg repo "$repo" \
    --arg branch "$branch" \
    --arg ctx "$ctx" \
    --arg ctx_pct "$ctx_pct" \
    --arg tokens "$tokens" \
    --arg spend "$spend" \
    --arg cache "$cache" \
    --arg limit_5h "$limit_5h" \
    --arg reset_5h "$rst_5h" \
    --arg limit_7d "$limit_7d" \
    --arg reset_7d "$rst_7d" \
    '{$agent, $model, $effort, $effort_long, $repo, $branch, $ctx,
      ctx_pct: (if $ctx_pct == "" then null else ($ctx_pct | tonumber?) end),
      $tokens, $spend, $cache, $limit_5h, $reset_5h, $limit_7d, $reset_7d}' 2>/dev/null)
[ -n "$normalised" ] || exit 0

publish "$normalised"

exit 0
