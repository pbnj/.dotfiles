#!/usr/bin/env bash
# https://felixkratz.github.io/SketchyBar/

PLUGIN_DIR="$CONFIG_DIR/plugins"
FONT="JetBrainsMono Nerd Font"

# shellcheck source=colors.sh
source "$CONFIG_DIR/colors.sh"

sketchybar --add event theme_refresh \
  --add event theme_change AppleInterfaceThemeChangedNotification

sketchybar --bar \
  position=top \
  height=32 \
  color="$BG" \
  blur_radius=20 \
  padding_left=8 \
  padding_right=8

# Paired content has equal outer padding; the two 2px inner pads form a 4px gap.
default=(
  padding_left=4
  padding_right=4
  icon.font="$FONT:Bold:15.0"
  label.font="$FONT:Bold:13.0"
  icon.color="$FG"
  label.color="$FG"
  icon.padding_left=8
  icon.padding_right=2
  label.padding_left=2
  label.padding_right=8
  background.color="$ITEM_BG"
  background.corner_radius=6
  background.height=24
)
sketchybar --default "${default[@]}"

# A hidden label contributes no padding, so icon-only items need both edges.
icon_only=(icon.padding_left=8 icon.padding_right=8 label.drawing=off)

# Group members share a 4px gap, not two full 8px pill insets. Only the
# first/last visible member gets the group's 8px outer content padding.
group_member=(
  padding_left=0
  padding_right=0
  background.drawing=off
  icon.padding_left=2
  label.padding_right=2
)

# left: apple menu
popup_item=(
  background.drawing=off
  icon.padding_left=8
  label.padding_right=8
  padding_left=0
  padding_right=0
)
sketchybar --add item apple.logo left \
  --set apple.logo icon= icon.font="$FONT:Bold:17.0" icon.color="$GREEN" \
  background.drawing=off "${icon_only[@]}" \
  click_script="sketchybar --set apple.logo popup.drawing=toggle" \
  popup.background.color="$BG" popup.background.border_color="$SELECTED_BG" \
  popup.background.border_width=2 popup.background.corner_radius=8 \
  --add item apple.prefs popup.apple.logo \
  --set apple.prefs "${popup_item[@]}" icon= label=Preferences \
  click_script="open -a 'System Settings'; sketchybar --set apple.logo popup.drawing=off" \
  --add item apple.activity popup.apple.logo \
  --set apple.activity "${popup_item[@]}" icon= label=Activity \
  click_script="open -a 'Activity Monitor'; sketchybar --set apple.logo popup.drawing=off" \
  --add item apple.lock popup.apple.logo \
  --set apple.lock "${popup_item[@]}" icon= label="Lock Screen" \
  click_script="sketchybar --set apple.logo popup.drawing=off; pmset displaysleepnow"

# left: aerospace workspaces, each with icons for the apps on it
# (sketchybar-app-font). empty workspaces are hidden by plugins/aerospace.sh.
WORKSPACES=()
while IFS= read -r ws; do
  WORKSPACES+=("$ws")
done < <(aerospace list-workspaces --all 2>/dev/null)

sketchybar --add event aerospace_workspace_change

for ws in "${WORKSPACES[@]}"; do
  space=(
    drawing=off
    icon="$ws"
    icon.padding_left=8
    icon.padding_right=8
    icon.highlight_color="$RED"
    padding_left=0
    padding_right=0
    background.drawing=off
    label.font="sketchybar-app-font:Regular:16.0"
    label.padding_left=8
    label.padding_right=8
    label.y_offset=-1
    label.background.color="$SELECTED_BG"
    label.highlight_color="$RED"
    label.background.height=24
    label.background.corner_radius=6
    label.drawing=off
    click_script="aerospace workspace $ws"
  )
  sketchybar --add item space."$ws" left --set space."$ws" "${space[@]}"
done

sketchybar --add bracket spaces '/space\..*/' \
  --set spaces background.color="$ITEM_BG" background.corner_radius=6 background.height=24

# redraws every workspace item: on workspace switches, and on window
# open/close/focus so the app icons stay current
sketchybar --add item space_windows left \
  --set space_windows drawing=off script="$PLUGIN_DIR/aerospace.sh" \
  --subscribe space_windows aerospace_workspace_change space_windows_change front_app_switched system_woke theme_refresh

sketchybar --add item front_app left \
  --set front_app icon.drawing=off label.padding_left=8 background.drawing=off script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

# right (added right-to-left)
sketchybar --add item clock right \
  --set clock update_freq=10 icon= script="$PLUGIN_DIR/clock.sh" \
  click_script="open -a Calendar"

# twingate login needs helpers/bin/twingate_menu, which needs Accessibility. It
# is only built when missing: a rebuild changes its signature and revokes the
# grant.
TWINGATE_MENU="$CONFIG_DIR/helpers/bin/twingate_menu"
if [ ! -x "$TWINGATE_MENU" ]; then
  mkdir -p "$(dirname "$TWINGATE_MENU")"
  swiftc -O "$CONFIG_DIR/helpers/twingate_menu.swift" -o "$TWINGATE_MENU"
fi

sketchybar --add item twingate right \
  --set twingate update_freq=10 icon=󰦝 "${icon_only[@]}" \
  script="$PLUGIN_DIR/twingate.sh" click_script="$PLUGIN_DIR/twingate_click.sh" \
  --subscribe twingate system_woke theme_refresh

sketchybar --add item wifi right \
  --set wifi update_freq=10 icon=󰤭 "${icon_only[@]}" \
  script="$PLUGIN_DIR/wifi.sh" \
  click_script="open x-apple.systempreferences:com.apple.wifi-settings-extension" \
  --subscribe wifi wifi_change system_woke theme_refresh

# Audio stays icon-only; its popup shows volume and the default I/O devices.
audio_row=(
  "${popup_item[@]}"
  click_script="open x-apple.systempreferences:com.apple.Sound-Settings.extension; sketchybar --set volume popup.drawing=off"
)
sketchybar --add item volume right \
  --set volume icon=󰕾 "${icon_only[@]}" update_freq=5 script="$PLUGIN_DIR/volume.sh" \
  popup.align=right popup.background.color="$BG" popup.background.border_color="$SELECTED_BG" \
  popup.background.border_width=2 popup.background.corner_radius=8 \
  --subscribe volume volume_change mouse.clicked system_woke theme_refresh \
  --add item volume.level popup.volume \
  --set volume.level "${audio_row[@]}" icon=󰕾 label="Volume: …" \
  --add item volume.output popup.volume \
  --set volume.output "${audio_row[@]}" icon=󰓃 label="Output: …" \
  --add item volume.input popup.volume \
  --set volume.input "${audio_row[@]}" icon= label="Input: …" \
  --add item volume.settings popup.volume \
  --set volume.settings "${audio_row[@]}" icon= label="Sound Settings"

sketchybar --add item battery right \
  --set battery "${group_member[@]}" label.padding_right=8 update_freq=120 script="$PLUGIN_DIR/battery.sh" \
  click_script="open x-apple.systempreferences:com.apple.Battery-Settings.extension" \
  --subscribe battery system_woke power_source_change theme_refresh \
  --add item disk right \
  --set disk "${group_member[@]}" update_freq=60 icon=SSD icon.font="$FONT:Bold:11.0" icon.color="$ACCENT" script="$PLUGIN_DIR/disk.sh" \
  click_script="open 'x-apple.systempreferences:com.apple.settings.Storage'" \
  --add item memory right \
  --set memory "${group_member[@]}" update_freq=5 icon=MEM icon.font="$FONT:Bold:11.0" icon.color="$ACCENT" script="$PLUGIN_DIR/memory.sh" \
  click_script="open -a 'Activity Monitor'" \
  --add item cpu right \
  --set cpu "${group_member[@]}" icon.padding_left=8 update_freq=5 icon=CPU icon.font="$FONT:Bold:11.0" icon.color="$ACCENT" script="$PLUGIN_DIR/cpu.sh" \
  click_script="open -a 'Activity Monitor'"

sketchybar --add bracket stats cpu memory disk battery \
  --set stats background.color="$ITEM_BG" background.corner_radius=6 background.height=24

# docker: just the whale, hidden unless Docker Desktop is running; a click
# drops down the container, image and volume counts (plugins/docker.sh, run by
# the whale, fills them in), and a row opens Docker Desktop.
docker_row=(
  background.drawing=off
  icon.font="$FONT:Bold:15.0"
  icon.color="$ACCENT"
  icon.padding_left=8
  label.padding_right=8
  padding_left=0
  padding_right=0
  click_script="open 'docker-desktop://dashboard/open'; sketchybar --set docker popup.drawing=off"
)
sketchybar --add item docker right \
  --set docker drawing=off icon= icon.color="$ACCENT" "${icon_only[@]}" \
  update_freq=10 script="$PLUGIN_DIR/docker.sh" \
  click_script="sketchybar --set docker popup.drawing=toggle" \
  popup.align=right popup.background.color="$BG" popup.background.border_color="$SELECTED_BG" \
  popup.background.border_width=2 popup.background.corner_radius=8 \
  --add item docker.containers popup.docker \
  --set docker.containers "${docker_row[@]}" icon=󰆧 \
  --add item docker.images popup.docker \
  --set docker.images "${docker_row[@]}" icon=󰮄 \
  --add item docker.volumes popup.docker \
  --set docker.volumes "${docker_row[@]}" icon=󰋊

# claude: session state on the icon (idle/working/blocked) and the 5h / 7d
# usage limits as a grouped pill like the stats, published by the Claude Code
# "usage" mod. plugins/claude.sh, run by the icon item, sets all three. It runs
# only on the mod's claude_update events, never on a timer.
# left-clicking the icon lists every Claude pane in tmux, right-clicking jumps
# to the session that needs you; the limits open the usage page.
claude_window=(
  drawing=off
  "${group_member[@]}"
  icon.font="$FONT:Bold:11.0"
  icon.color="$ACCENT"
  click_script="open https://claude.ai/settings/usage"
)
sketchybar --add event claude_update \
  --add item claude.7d right \
  --set claude.7d "${claude_window[@]}" icon=7d \
  --add item claude.5h right \
  --set claude.5h "${claude_window[@]}" icon=5h \
  --add item claude right \
  --set claude "${group_member[@]}" \
  icon=:claude: icon.font="sketchybar-app-font:Regular:16.0" "${icon_only[@]}" \
  script="$PLUGIN_DIR/claude.sh" \
  popup.align=right popup.background.color="$BG" popup.background.border_color="$SELECTED_BG" \
  popup.background.border_width=2 popup.background.corner_radius=8 \
  --subscribe claude claude_update mouse.clicked theme_refresh \
  --add bracket claude_group claude claude.5h claude.7d \
  --set claude_group background.color="$ITEM_BG" background.corner_radius=6 background.height=24

# pi: the user extension publishes a per-session working/idle/blocked state.
# The icon color shows the most urgent state; clicking it lists every Pi
# session and focuses its tmux pane in Ghostty when available.
sketchybar --add item pi right \
  --set pi drawing=off icon=π icon.font="$FONT:Bold:15.0" "${icon_only[@]}" \
  update_freq=5 script="$PLUGIN_DIR/pi.sh" \
  click_script="$PLUGIN_DIR/pi_click.sh" \
  popup.align=right popup.background.color="$BG" popup.background.border_color="$SELECTED_BG" \
  popup.background.border_width=2 popup.background.corner_radius=8 \
  --subscribe pi system_woke theme_refresh

# One native macOS appearance listener; no polling. The updater fans out a
# separate event after applying base colors so stateful plugins cannot race it.
sketchybar --add item theme_watcher left \
  --set theme_watcher drawing=off updates=on script="$PLUGIN_DIR/theme.sh" \
  --subscribe theme_watcher theme_change system_woke

sketchybar --update
