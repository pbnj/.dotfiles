# vim:ft=bash:ts=2:sw=2:sts=2:et:
# shellcheck shell=bash

# BREW
[[ -d "/opt/homebrew/bin" ]] && eval "$(/opt/homebrew/bin/brew shellenv)"

# General
export EDITOR=nvim
export GIT_TERMINAL_PROMPT=1
export HISTCONTROL=ignoreboth
export GH_TELEMETRY=false
export RIPGREP_CONFIG_PATH="${HOME}/.config/ripgrep/.ripgreprc"

[[ ":${PATH}:" != *":${HOME}/.local/bin:"* ]] && PATH="${HOME}/.local/bin:${PATH}"
[[ ":${PATH}:" != *":${HOME}/.aws:"* ]] && PATH="${HOME}/.aws:${PATH}"

# Go
export GODEBUG=x509ignoreCN=0
export GOPATH="${HOME}/go"
[[ ":${PATH}:" != *":${GOPATH}/bin:"* ]] && PATH="${GOPATH}/bin:${PATH}"

# Native macOS SSH agent, instead of routing Git through the 1Password agent.
# launchd hands SSH_AUTH_SOCK to GUI-launched processes via SecureSocketWithKey,
# which `launchctl getenv` cannot see -- so trust the inherited value whenever a
# live agent answers on it, and only search for a socket when nothing does.
# ssh-add -l exits 2 when no agent is reachable (1 just means "agent, no keys").
if [[ "$(uname)" == "Darwin" ]]; then
  ssh-add -l >/dev/null 2>&1
  if [[ $? -eq 2 ]]; then
    for ssh_auth_sock in \
      "$(/bin/launchctl getenv SSH_AUTH_SOCK 2>/dev/null)" \
      /var/run/com.apple.launchd.*/Listeners; do
      if [[ -S "${ssh_auth_sock}" ]]; then
        export SSH_AUTH_SOCK="${ssh_auth_sock}"
        break
      fi
    done
    unset ssh_auth_sock
  fi
fi

# Rootless Docker
# docs: https://docs.docker.com/engine/security/rootless/
#   $ dockerd-rootless-setuptool.sh install
[[ "$(uname)" == "Linux" ]] && export DOCKER_HOST=unix:///run/user/1000/docker.sock

# # PROMPT
export PS1='\e]133;A\a\n\w$(__git_branch)\n\$ '
# export PS1='\e]133;A\a\n\$ '

# PATH (must be last)
export PATH
