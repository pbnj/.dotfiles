# vim:ft=bash:
# shellcheck shell=bash

# Hint: `complete -p` shows all completions in the form of commands you can run
# to replicate the completion behavior for aliases.

# general
alias ll="ls -alFh --color"
alias grep="grep --color=auto"

# vim
alias vim=nvim
alias vi="vim --clean"
alias vfp='nvim -c "lua Snacks.picker.files({ cwd = \"~/Projects\", layout = { fullscreen = true } })"'
alias vga='nvim -c "lua Snacks.picker.grep({ title = \"Grep (all projects)\", dirs = { \"~/Projects/\" }, layout = { fullscreen = true } })"'
alias awsc='nvim -c AWSConsole'
alias okta='nvim -c Okta'

# brew
alias buc='brew upgrade && brew cleanup --prune=all'

# tmux
alias tm="tmux -u a || tmux -u"

alias luna='pi --model gpt-6-luna --thinking max'
alias sol='pi --model gpt-6.1-sol --thinking high'
alias opus='claude --model opus --effort medium --dangerously-skip-permissions'
alias haiku='claude --model haiku --effort max --dangerously-skip-permissions'

# kubernetes
alias kx=kubectx
complete -F _kube_contexts kx
alias kn=kubens
complete -F _kube_namespaces kn
if [[ -f "$HOME/.kube/aliases" ]]; then
        source "$HOME/.kube/aliases"
else
        alias k=kubectl
        complete -o default -F __start_kubectl k
fi

# git
alias g=git
alias ga="git add"
alias gc="git commit"
alias gco="git checkout"
alias gcob="git checkout -b"
alias gpull="git pull"
alias gpush="git push"
alias gs="git status"
alias gsync="git pull origin main"

# gh
alias ghas="gh auth switch"
alias ghrv="gh run view"
alias ghrw="gh run watch"
alias ghwr="gh workflow run"
