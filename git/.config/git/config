[alias]
	alias = !git config -l | grep ^alias | cut -c 7- | sort
	b = browse
	branches = branch -a --sort=-committerdate
	c = commit
	co = checkout
	cob = checkout -b
	com = checkout main
	comp = !git checkout main && git pull origin main
	contributors = shortlog --summary --numbered --email
	czc = cz commit
	graph = log --graph --color --pretty=format:"%C(yellow)%H%C(green)%d%C(reset)%n%x20%cd%n%x20%cn%x20(%ce)%n%x20%s%n"
	l = log --pretty=oneline --graph --abbrev-commit
	ls = ls-files
	p = push
	remotes = remote -v
	s = status
	tags = tag --list
	top = !git log --format=format:%an | sort | uniq -c | sort -r | head -n 20
	undo = !git reset HEAD~1 --mixed
	unstage = reset
	whatchanged = log --raw --no-merges
	; git find [-p] <pattern> -- with -p, print each matching commit's full diff.
	; The diff is deliberately not narrowed with -G: that would re-filter the list
	; and silently drop commits that matched only on the message.
	find = "!f(){ patch=; if [ \"$1\" = \"-p\" ]; then patch=-p; shift; fi; shas=$( { git log --all --format=%H -i -F --grep=\"$1\"; git log --all --format=%H -i -S\"$1\"; } | sort -u ); if [ -z \"$shas\" ]; then echo \"git find: no commits match: $1\" >&2; return 1; fi; printf \"%s\\n\" \"$shas\" | git log --no-walk=sorted --stdin --oneline --date-order $patch; }; f"

[apply]
	whitespace = fix

[core]
	excludesFile = ~/.config/git/ignore
	whitespace = space-before-tab,-indent-with-non-tab,trailing-space
	trustctime = false

[merge]
	conflictStyle = diff3
	defaultToUpstream = true
	tool = vimdiff

[difftool "nvim_difftool"]
  cmd = nvim -d "$LOCAL" "$REMOTE"

[diff]
  tool = nvim_difftool

; [diff]
; 	tool = vimdiff
; 	colorMoved = default

[branch]
	autoSetupMerge = always

[color]
	ui = auto

[push]
	default = current
	autoSetupRemote = true

[pull]
	rebase = false

[init]
	defaultBranch = main

[commit]
	verbose = true

[grep]
	lineNumber = true
	column = true
	fallbackToNoIndex = true

[log]
	showSignature = false
	diffMerges = on

[commit]
	gpgsign = true
[tag]
	gpgsign = true
; Use the stock OpenSSH signer with the local keys configured below.
; The matching private keys are loaded into the macOS SSH agent, not 1Password.
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers

[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f

; personal config loaded first so work configs below can override it
[include]
	path = ~/.config/git/personal.config

; work config
;
; Matched on every URL form a work remote can take, not just https: ~20 local
; repos already use the git@ form, and those were previously selected only by the
; gitdir rules below -- so a work repo cloned outside ~/Projects/github.com/ would
; have silently fallen back to the personal identity.
;
; insteadOf rewrites happen at transport time and never touch .git/config, so the
; stored URL these patterns match stays whatever was cloned. The `work:` patterns
; cover remotes edited to the alias form by hand.
[includeIf "hasconfig:remote.*.url:https://github.com/komodohealth/**"]
	path = ~/.config/git/work.config
[includeIf "hasconfig:remote.*.url:git@github.com:komodohealth/**"]
	path = ~/.config/git/work.config
[includeIf "hasconfig:remote.*.url:work:komodohealth/**"]
	path = ~/.config/git/work.config
[includeIf "gitdir:~/Projects/github.com/komodohealth/"]
	path = ~/.config/git/work.config

; No credential helper here on purpose: personal.config and work.config each set
; their own, so the identity follows whichever file the includeIf rules pick.

; SSH transport. The `work` and `personal` aliases are defined in ~/.ssh/config;
; each uses one local private key and disables ambient SSH agents, so exactly one
; identity is offered. This avoids authenticating as the wrong GitHub account.
;
; These rewrites are unconditional (not in work.config) because includeIf does not
; match during `git clone` from an unrelated directory. Both this rule and the
; `personal:pbnj/` one are scoped to a single owner prefix, so they never overlap
; and every other github.com URL is left on plain HTTPS. insteadOf affects
; transport only and never rewrites .git/config, so the includeIf rules above
; still see the URL as cloned.
[url "work:komodohealth/"]
	insteadOf = https://github.com/komodohealth/
	insteadOf = git@github.com:komodohealth/
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
