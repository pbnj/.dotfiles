[alias]
	alias = !git config -l | grep ^alias | cut -c 7- | sort
	b = browse
	branches = branch -a --sort=-committerdate
	c = commit
	co = checkout
	cob = checkout -b
	com = checkout main
	; --git-common-dir resolves to the *main* worktree's .git even from inside a
	; linked worktree, so this walks out to the original checkout rather than
	; stopping at the worktree root. An alias runs in a subprocess and so cannot
	; move the calling shell: it prints the root, for use as `cd "$(git cdroot)"`.
	cdroot = "!f(){ gitdir=$(git rev-parse --path-format=absolute --git-common-dir) || return 1; cd -- \"$(dirname \"$gitdir\")\" && pwd; }; f"
	comp = "!f(){ unset GIT_DIR GIT_WORK_TREE; root=$(git cdroot) || return 1; cd -- \"$root\" || return 1; def=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null); def=${def#origin/}; git checkout \"${def:-main}\" && git pull origin \"${def:-main}\"; }; f"
	contributors = shortlog --summary --numbered --email
	czc = cz commit
	graph = log --graph --color --pretty=format:"%C(yellow)%H%C(green)%d%C(reset)%n%x20%cd%n%x20%cn%x20(%ce)%n%x20%s%n"
	l = log --pretty=oneline --graph --abbrev-commit
	ls = ls-files
	p = push
	remotes = remote -v
	s = status
	tags = tag --list
	top = !git log --format=format:%an | sort | uniq -c | sort -r | head -n 20
	; short form of the git-unresolved script on PATH (unresolved PR review threads)
	uc = unresolved
	; short form of the git-failing-checks script on PATH (failing PR CI checks)
	fc = failing-checks
	undo = !git reset HEAD~1 --mixed
	unstage = reset
	whatchanged = log --raw --no-merges
	; git find [-p] <pattern> -- with -p, print each matching commit's full diff.
	; The diff is deliberately not narrowed with -G: that would re-filter the list
	; and silently drop commits that matched only on the message.
	find = "!f(){ patch=; if [ \"$1\" = \"-p\" ]; then patch=-p; shift; fi; shas=$( { git log --all --format=%H -i -F --grep=\"$1\"; git log --all --format=%H -i -S\"$1\"; } | sort -u ); if [ -z \"$shas\" ]; then echo \"git find: no commits match: $1\" >&2; return 1; fi; printf \"%s\\n\" \"$shas\" | git log --no-walk=sorted --stdin --oneline --date-order $patch; }; f"

[apply]
	whitespace = fix

[core]
	excludesFile = ~/.config/git/ignore
	whitespace = space-before-tab,-indent-with-non-tab,trailing-space
	trustctime = false

[merge]
	conflictStyle = diff3
	defaultToUpstream = true
	tool = vimdiff

[difftool "nvim_difftool"]
  cmd = nvim -d "$LOCAL" "$REMOTE"

[diff]
  tool = nvim_difftool

; [diff]
; 	tool = vimdiff
; 	colorMoved = default

[branch]
	autoSetupMerge = always

[color]
	ui = auto

[push]
	default = current
	autoSetupRemote = true

[pull]
	rebase = false

[init]
	defaultBranch = main

[commit]
	verbose = true

[grep]
	lineNumber = true
	column = true
	fallbackToNoIndex = true

[log]
	showSignature = false
	diffMerges = on

[commit]
	gpgsign = true
[tag]
	gpgsign = true
; Use the stock OpenSSH signer with the local keys configured below.
; The matching private keys are loaded into the macOS SSH agent, not 1Password.
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers

[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f

; personal config loaded first so work configs below can override it
[include]
	path = ~/.config/git/personal.config

; work config
;
; Matched on the stored URL as well as the checkout path, so a work repo cloned
; outside ~/Projects/github.com/ still gets the work identity. The git@ form is
; kept for any remote still stored that way; the insteadOf rules below send it
; over HTTPS regardless.
[includeIf "hasconfig:remote.*.url:https://github.com/komodohealth/**"]
	path = ~/.config/git/work.config
[includeIf "hasconfig:remote.*.url:git@github.com:komodohealth/**"]
	path = ~/.config/git/work.config
[includeIf "gitdir:~/Projects/github.com/komodohealth/"]
	path = ~/.config/git/work.config

; All GitHub transport is HTTPS. Any SSH-style URL -- git@, ssh://, or the old
; `work:`/`personal:` host aliases -- is rewritten at transport time, so nothing
; ever reaches for an SSH key. insteadOf never touches .git/config, so the
; includeIf rules above still see the URL as stored.
[url "https://github.com/"]
	insteadOf = git@github.com:
	insteadOf = ssh://git@github.com/
	insteadOf = work:
	insteadOf = personal:

; HTTPS credentials come from gh's keyring, picked per account with
; `gh auth token --user`, so neither account has to be gh's active one.
;
; Scoped by owner URL here rather than in work.config/personal.config because
; includeIf does not match during `git clone` from an unrelated directory.
; useHttpPath makes git match the repo path against the komodohealth/ prefix;
; everything else on github.com, including third-party public repos, uses the
; personal token. The helper answers `get` only, so git's `store`/`erase` calls
; never touch the keyring.
[credential "https://github.com"]
	helper =
	helper = "!f() { test \"$1\" = get && echo username=pbnj && echo password=$(/opt/homebrew/bin/gh auth token --user pbnj); }; f"
[credential "https://github.com/komodohealth"]
	useHttpPath = true
	helper =
	helper = "!f() { test \"$1\" = get && echo username=peterbenjamin-kh && echo password=$(/opt/homebrew/bin/gh auth token --user peterbenjamin-kh); }; f"
[credential "https://gist.github.com"]
	helper =
	helper = "!f() { test \"$1\" = get && echo username=pbnj && echo password=$(/opt/homebrew/bin/gh auth token --user pbnj); }; f"
[fetch]
	prune = true
