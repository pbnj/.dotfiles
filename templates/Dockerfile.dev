FROM ubuntu:26.04

# disable interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# install dependencies
# hadolint ignore=DL3008 # a dev image wants current packages, not pinned ones
RUN : \
        && apt-get update \
        && apt-get install --no-install-recommends -y \
            bash-completion \
            curl \
            git \
            make \
            stow \
            tmux \
            vim \
        && rm -rf /var/lib/apt/lists/*
