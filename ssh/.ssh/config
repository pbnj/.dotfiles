# Git transport uses the local encrypted key files directly, never the
# 1Password agent. `UseKeychain` lets macOS retrieve each key's passphrase from
# the system Keychain after the one-time `ssh-add --apple-use-keychain` setup.
Host personal
        HostName github.com
        User git
        IdentityFile ~/.ssh/personal
        IdentitiesOnly yes
        IdentityAgent none
        UseKeychain yes

Host work
        HostName github.com
        User git
        IdentityFile ~/.ssh/work
        IdentitiesOnly yes
        IdentityAgent none
        UseKeychain yes
